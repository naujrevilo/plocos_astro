{
  "name": "plocos",
  "type": "module",
  "version": "0.1.45",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build --remote",
    "preview": "astro preview",
    "astro": "astro",
    "import:plocos": "node scripts/import-plocos.js",
    "flatten:posts": "node scripts/flatten-posts.mjs",
    "flatten:posts:write": "node scripts/flatten-posts.mjs --write",
    "check:pages": "astro check --path src/pages",
    "verify:pacto": "node scripts/verify-pacto-body.mjs",
    "verify:pacto:self-check": "node scripts/verify-pacto-body.mjs --self-check",
    "verify:schema": "node --import tsx -e \"import('./src/lib/db/schema.ts').then(m => { const entityKind = Symbol.for('drizzle:entityKind'); const tables = Object.entries(m).filter(([, v]) => v && typeof v === 'object' && typeof v.constructor?.[entityKind] === 'string' && (v.constructor[entityKind] === 'Table' || v.constructor[entityKind] === 'SQLiteTable')).map(([k]) => k); if (!tables.length) { console.error('Schema FAILED: no tables found'); process.exit(1); } console.log('Schema OK, tables:', tables); }).catch(err => { console.error('Schema FAILED:', err.message); process.exit(1); })\"",
    "prebuild": "pnpm verify:pacto",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/netlify": "8.2.5",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight-docsearch": "0.8.0",
    "@libsql/client": "^0.18.0",
    "all": "^0.0.0",
    "astro": "7.3.1",
    "astro-consent": "^2.1.1",
    "flowbite": "4.0.2",
    "preact": "10.29.8",
    "remove-markdown": "0.7.0",
    "slugify": "1.6.9",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "19.2.18",
    "@vitest/expect": "^5.0.3",
    "autoprefixer": "10.5.5",
    "dotenv": "17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "fs-extra": "11.4.0",
    "gray-matter": "4.0.3",
    "he": "1.2.0",
    "instantsearch.css": "8.22.0",
    "postcss": "8.5.28",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "ts-node": "10.9.2",
    "tsx": "4.23.13",
    "turndown": "7.2.4",
    "vitest": "^5.0.3",
    "yup": "1.7.1",
    "zod": "4.5.4"
  }
}
