# TinaCMS Configuration
# Para obtener estas credenciales:
# 1. Ve a https://app.tina.io/register
# 2. Crea una cuenta gratuita
# 3. Crea un nuevo proyecto
# 4. Copia el clientId y token aquí

# TINA_CLIENT_ID=tu-client-id-aqui
# TINA_TOKEN=tu-token-aqui

# Una vez configuradas las credenciales arriba, descomenta estas líneas
# y actualiza tina/config.ts con:
# client: {
#   skip: false,
#   clientId: process.env.TINA_CLIENT_ID,
#   token: process.env.TINA_TOKEN,
# }
