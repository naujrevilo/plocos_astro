---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/posts';
import { labelToSlug } from '../lib/taxonomy';
import { defaultLocale, getTranslations, type Locale } from '../lib/i18n';
import { createLocaleHref } from '../lib/routes';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const translations = getTranslations(locale);
const { data } = post;
const postPath = `${translations.paths.posts}/${post.slug}`;
const postUrl = createLocaleHref(locale, postPath);
const labels = data.labels ?? [];
const categories = data.categories ?? [];
const author = data.author ?? 'Michel Saer (MSD)';
const labelPath = translations.paths.labels;
const formattedDate = formatDate(data.pubDate, locale);
const imageAltPrefix = translations.posts.imageAlt;
const heroImageAlt = data.heroImageAlt?.trim() || `${imageAltPrefix} ${data.title}`;
---
<article class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-border-subtle bg-surface-elevated shadow-contemplation transition hover:border-accent">
  {data.heroImage && (
    <a href={postUrl} class="block overflow-hidden">
      <img
        src={data.heroImage}
        alt={heroImageAlt}
        loading="lazy"
        class="h-60 w-full object-cover transition duration-300 group-hover:scale-[1.02]"
      />
    </a>
  )}
  <div class="flex flex-1 flex-col gap-4 px-6 py-6">
    <div class="flex items-center justify-between text-xs uppercase tracking-wide text-text-secondary opacity-80">
  <time datetime={data.pubDate.toISOString()} class="font-semibold text-text-secondary">
        {formattedDate}
      </time>
      <span class="flex items-center gap-1 text-[0.7rem] text-text-secondary">
        {author}
      </span>
    </div>
    <div class="space-y-3">
      <h2 class="text-xl font-semibold tracking-tight text-text-primary">
        <a href={postUrl} class="transition-colors hover:text-accent">
          {data.title}
        </a>
      </h2>
      {data.summary && (
        <p class="line-clamp-4 text-sm leading-relaxed text-text-secondary">
          {data.summary}
        </p>
      )}
    </div>
    {categories.length > 0 && (
      <ul class="flex flex-wrap gap-2 text-[0.7rem] text-text-secondary">
        {categories.map((category: string) => (
          <li class="rounded-full border border-border-subtle bg-surface-muted px-3 py-1 uppercase tracking-wide">
            {category}
          </li>
        ))}
      </ul>
    )}
    {labels.length > 0 && (
      <ul class="mt-auto flex flex-wrap gap-2 text-xs text-text-accent">
        {labels.map((label: string) => (
          <li>
            <a
              href={createLocaleHref(locale, `${labelPath}/${labelToSlug(label)}`)}
              class="inline-flex items-center gap-2 rounded-full border border-accent-muted bg-accent-soft px-3 py-1 transition hover:border-accent hover:text-text-primary"
            >
              <span class="h-1.5 w-1.5 rounded-full bg-accent" />
              {label}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>
