---
interface Props {
  name: 'facebook' | 'instagram' | 'x';
  class?: string;
}

const { name, class: className = 'h-5 w-5' } = Astro.props as Props;

const svgClasses = `${className} fill-current`;
---
{(() => {
  switch (name) {
    case 'facebook':
      return (
        <svg class={svgClasses} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M22 12a10 10 0 1 0-11.5 9.87v-6.99H7.9V12h2.6V9.8c0-2.56 1.53-3.98 3.87-3.98 1.12 0 2.29.2 2.29.2v2.52h-1.29c-1.27 0-1.66.79-1.66 1.6V12h2.83l-.45 2.88h-2.38v6.99A10 10 0 0 0 22 12Z" />
        </svg>
      );
    case 'instagram':
      return (
        <svg class={svgClasses} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 8.2A3.2 3.2 0 1 1 15.2 12 3.2 3.2 0 0 1 12 15.2ZM16.85 6.5a1.17 1.17 0 1 0 0 2.34 1.17 1.17 0 0 0 0-2.34ZM19.5 7.05a4.64 4.64 0 0 0-1.29-3.28A4.64 4.64 0 0 0 14.93 2.5H9.07a4.64 4.64 0 0 0-3.28 1.27A4.64 4.64 0 0 0 4.5 7.05v5.86a4.64 4.64 0 0 0 1.29 3.28 4.64 4.64 0 0 0 3.28 1.27h5.86a4.64 4.64 0 0 0 3.28-1.27 4.64 4.64 0 0 0 1.29-3.28Zm-1.8 5.86a2.84 2.84 0 0 1-.78 2 2.84 2.84 0 0 1-2 .78H9.07a2.84 2.84 0 0 1-2-.78 2.84 2.84 0 0 1-.78-2V7.05a2.84 2.84 0 0 1 .78-2 2.84 2.84 0 0 1 2-.78h5.86a2.84 2.84 0 0 1 2 .78 2.84 2.84 0 0 1 .78 2Z" />
        </svg>
      );
    case 'x':
      return (
        <svg class={svgClasses} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M20.5 3.5h-3.04l-4.22 5.35L9.6 3.5H3.5l6.57 8.8-6.2 8.2h3.04l4.52-5.73 3.66 5.73h6.1l-6.9-9.04Z" />
        </svg>
      );
    default:
      return (
        <svg class={svgClasses} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="10" />
        </svg>
      );
  }
})()}
