---
import { defaultLocale, getTranslations, type Locale } from '../lib/i18n';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const translations = getTranslations(locale);
const { options, srLabel, ariaLabel } = translations.theme;
const iconMap: Record<'light' | 'dark' | 'system', string> = {
  light: '☀',
  dark: '🌙',
  system: '◎',
};
---
<label class="inline-flex items-center text-sm text-text-secondary">
  <span class="sr-only">{srLabel}</span>
  <select
    class="h-10 w-16 rounded-2xl border border-border-subtle bg-surface-elevated px-0 text-lg font-semibold leading-none text-text-secondary text-center transition hover:border-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
    data-theme-select
    aria-label={ariaLabel}
  >
    {options.map((option) => (
      <option value={option.value} title={option.label} aria-label={option.label}>
        {iconMap[option.value] ?? '•'}
      </option>
    ))}
  </select>
</label>
<script is:inline>
/**
 * @script
 * @description Script del lado del cliente para el ThemeToggle. Maneja la detección, aplicación y persistencia
 * de la preferencia de tema del usuario (claro, oscuro o sistema).
 */
  (() => {
    const storageKey = 'plocos-theme';
    const wrapper = document.currentScript?.previousElementSibling;
    const doc = document.documentElement;
    const media = window.matchMedia('(prefers-color-scheme: dark)');

    if (!(wrapper instanceof HTMLLabelElement)) {
      throw new Error('theme toggle render error');
    }

    const select = wrapper.querySelector('[data-theme-select]');

    if (!(select instanceof HTMLSelectElement)) {
      throw new Error('theme toggle select missing');
    }

    // Obtiene la preferencia de tema guardada en localStorage.
    const getStored = () => {
      try {
        const saved = localStorage.getItem(storageKey);
        return saved === 'light' || saved === 'dark' ? saved : 'system';
      } catch (error) {
        return 'system';
      }
    };

    // Aplica la preferencia de tema al documento.
    const setPreference = (mode) => {
      doc.dataset.themePreference = mode;
      if (mode === 'light') {
        doc.setAttribute('data-theme', 'light');
      } else if (mode === 'dark') {
        doc.setAttribute('data-theme', 'dark');
      } else {
        doc.removeAttribute('data-theme');
      }
    };

    // Actualiza el valor del select para reflejar el tema activo.
    const reflect = (mode) => {
      select.value = mode;
    };

    let preference = getStored();
    setPreference(preference);
    reflect(preference);

    // Guarda la preferencia de tema en localStorage.
    const persist = (mode) => {
      try {
        if (mode === 'system') {
          localStorage.removeItem(storageKey);
        } else {
          localStorage.setItem(storageKey, mode);
        }
      } catch (error) {
        /* ignorar errores de persistencia */
      }
    };

    // Maneja los cambios en la preferencia de color del sistema operativo.
    const handleSystemChange = () => {
      const active = doc.dataset.themePreference ?? 'system';
      if (active === 'system') {
        setPreference('system');
      }
    };

    // Event listener para el cambio en el select.
    select.addEventListener('change', (event) => {
      const value = event.target instanceof HTMLSelectElement ? event.target.value : select.value;
      preference = value === 'light' || value === 'dark' ? value : 'system';
      persist(preference);
      setPreference(preference);
      reflect(preference);
    });

    // Event listener para cambios en la preferencia de color del sistema.
    media.addEventListener('change', handleSystemChange);
  })();
</script>
