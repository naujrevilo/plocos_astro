---
import { defaultLocale, getTranslations, type Locale } from '../lib/i18n';
import { createLocaleHref } from '../lib/routes';
import SocialIcon from './icons/SocialIcon.astro';
import rawContactData from '../data/contact.json';

type SocialId = 'facebook' | 'instagram' | 'x';

type SocialLink = {
  id: SocialId;
  label: string;
  url: string;
};

type ContactData = {
  donation: {
    formAction: string;
    method: string;
    target: string;
    hostedButtonId: string;
    businessEmail: string;
    buttonImage: string;
    pixelImage: string;
  };
  social: SocialLink[];
};

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const translations = getTranslations(locale);
const currentYear = new Date().getFullYear();
const { rights, contactLabel, rss, terms: termsLabel, donate, follow } = translations.footer;
const contactData = rawContactData as ContactData;
const termsHref = createLocaleHref(locale, translations.paths.terms);
const donationLink = `${contactData.donation.formAction}?hosted_button_id=${encodeURIComponent(contactData.donation.hostedButtonId)}`;
const socialLinks = contactData.social;
const socialAnchorClass =
  'inline-flex h-10 w-10 items-center justify-center rounded-full border border-border-subtle bg-surface-muted text-text-primary transition hover:border-accent hover:bg-accent hover:text-surface-base hover:shadow-contemplation';
---
<footer class="border-t border-border-subtle bg-surface-base">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-8 text-sm text-text-secondary md:flex-row md:items-center md:justify-between">
    <p>© {currentYear} Plocos. {rights}</p>
    <div class="flex flex-col gap-4 md:items-end">
      <nav aria-label="Footer links" class="flex flex-wrap gap-x-4 gap-y-2 md:justify-end">
        <a href={termsHref} class="transition-colors hover:text-accent">{termsLabel}</a>
        <a href="/rss.xml" class="transition-colors hover:text-accent">{rss}</a>
       
        <a href={donationLink} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-accent">
          {donate}
        </a>
      </nav>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 md:justify-end">
        <span class="font-semibold text-text-primary">{follow}:</span>
        {socialLinks.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            class={socialAnchorClass}
            aria-label={social.label}
            title={social.label}
          >
            <SocialIcon name={social.id} class="h-5 w-5" />
            <span class="sr-only">{social.label}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
