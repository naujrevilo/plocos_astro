---
/**
 * @component SiteFooter
 * @description Renderiza el pie de página del sitio para el pivote NQLV. Incluye:
 *   - Copyright
 *   - Enlaces a Términos del Sitio, Habeas Scriptum, Términos de Auditoría,
 *     Declaración de Simbiosis Algorítmica, Privacidad, Cookies
 *   - Botón "Gestionar cookies"
 *   - Iconos de redes sociales (Follow:)
 */
import { defaultLocale, getTranslations, type Locale } from '../lib/i18n';
import { createLocaleHref } from '../lib/routes';
import SocialIcon from './icons/SocialIcon.astro';
import rawContactData from '../data/contact.json';

type SocialId = 'facebook' | 'instagram' | 'x';

type SocialLink = {
  id: SocialId;
  label: string;
  url: string;
};

type ContactData = {
  email: string;
  social: SocialLink[];
};

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const translations = getTranslations(locale);
const currentYear = new Date().getFullYear();
const { rights, follow, manageCookies } = translations.footer;
const contactData = rawContactData as ContactData;

const isES = locale === 'es';

// URLs to the three legal sub-pages. The parent segment comes from the i18n
// `paths.terms` registry (ES `terminos`, EN `terms`); the sub-page slugs are
// shared by both locales (see src/pages/terminos and src/pages/en/terms).
const termsSegment = translations.paths.terms;
const subPageHrefs = {
  habeasScriptum: createLocaleHref(locale, `${termsSegment}/habeas-scriptum`),
  auditoria: createLocaleHref(locale, `${termsSegment}/auditoria`),
  simbiosis: createLocaleHref(locale, `${termsSegment}/simbiosis-algoritmica`),
};
const termsHref = createLocaleHref(locale, termsSegment);
const privacyHref = createLocaleHref(locale, translations.paths.privacy);
const cookiesHref = createLocaleHref(locale, translations.paths.cookiePolicy);

const socialLinks = contactData.social;
const socialAnchorClass =
  'inline-flex h-10 w-10 items-center justify-center rounded-full text-text-secondary transition-all duration-200 hover:bg-surface-muted hover:text-accent hover:scale-110 hover:-translate-y-0.5';
---
<footer class="border-t border-border-subtle bg-surface-base">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-8 text-sm text-text-secondary md:flex-row md:items-start md:justify-between">
    <p class="shrink-0">© {currentYear} Plocos. {rights}</p>

    <div class="flex flex-col gap-4 md:items-end">
      <nav aria-label="Footer legal" class="flex flex-col gap-2 md:items-end text-xs">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 md:justify-end">
          <a href={termsHref} class="font-semibold text-text-primary transition-colors hover:text-accent">
            {isES ? 'Términos del Sitio' : 'Site Terms'}
          </a>
          <a href={subPageHrefs.habeasScriptum} class="transition-colors hover:text-accent">
            {isES ? 'Habeas Scriptum' : 'Habeas Scriptum'}
          </a>
          <a href={subPageHrefs.auditoria} class="transition-colors hover:text-accent">
            {isES ? 'Términos de Auditoría' : 'Auditor Terms'}
          </a>
          <a href={subPageHrefs.simbiosis} class="transition-colors hover:text-accent">
            {isES ? 'Simbiosis Algorítmica' : 'Algorithmic Symbiosis'}
          </a>
        </div>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 md:justify-end">
          <a href={privacyHref} class="transition-colors hover:text-accent">
            {isES ? 'Privacidad' : 'Privacy'}
          </a>
          <a href={cookiesHref} class="transition-colors hover:text-accent">
            {isES ? 'Cookies' : 'Cookies'}
          </a>
          <button
            type="button"
            id="manage-cookies"
            class="transition-colors hover:text-accent"
            data-action="manage-cookies"
          >
            {manageCookies}
          </button>
        </div>
      </nav>

      <script is:inline>
        document.addEventListener("click", function (e) {
          var t = e.target;
          if (!(t instanceof HTMLElement)) return;
          if (t.id === "manage-cookies" || t.dataset.action === "manage-cookies") {
            var ac = window.astroConsent;
            if (ac && typeof ac.reset === "function") {
              ac.reset();
            }
          }
        });
      </script>

      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 md:justify-end">
        <span class="font-semibold text-text-primary">{follow}:</span>
        {socialLinks.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            class={socialAnchorClass}
            aria-label={social.label}
            title={social.label}
          >
            <SocialIcon name={social.id} class="h-5 w-5" />
            <span class="sr-only">{social.label}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
