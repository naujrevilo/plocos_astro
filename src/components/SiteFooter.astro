---
import { defaultLocale, getTranslations, type Locale } from '../lib/i18n';
import { createLocaleHref } from '../lib/routes';
import SocialIcon from './icons/SocialIcon.astro';
import rawContactData from '../data/contact.json';

type SocialId = 'facebook' | 'instagram' | 'x';

type SocialLink = {
  id: SocialId;
  label: string;
  url: string;
};

type ContactData = {
  email: string;
  social: SocialLink[];
};

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const translations = getTranslations(locale);
const currentYear = new Date().getFullYear();
const { rights, rss, terms: termsLabel, follow } = translations.footer;
const contactData = rawContactData as ContactData;
const termsHref = createLocaleHref(locale, translations.paths.terms);

const socialLinks = contactData.social;
// Shared styles for icon-only social buttons in the footer to mirror post share actions.
const socialAnchorClass =
  'inline-flex h-10 w-10 items-center justify-center rounded-full border border-border-subtle bg-surface-muted text-text-primary transition hover:border-accent hover:bg-accent hover:text-surface-base hover:shadow-contemplation';
---
<footer class="border-t border-border-subtle bg-surface-base">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-8 gap-y-4 px-4 py-8 text-sm text-text-secondary md:justify-between">
    <p>© {currentYear} Plocos. {rights}</p>
    <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-2">
      <a href={termsHref} class="transition-colors hover:text-accent">{termsLabel}</a>
      <a href="/rss.xml" class="transition-colors hover:text-accent">{rss}</a>
      <div class="flex items-center gap-x-4">
        <span class="font-semibold text-text-primary">{follow}:</span>
        {socialLinks.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            class={socialAnchorClass}
            aria-label={social.label}
            title={social.label}
          >
            <SocialIcon name={social.id} class="h-5 w-5" />
            <span class="sr-only">{social.label}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
