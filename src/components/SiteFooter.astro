---
import { defaultLocale, getTranslations, type Locale } from '../lib/i18n';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const translations = getTranslations(locale);
const currentYear = new Date().getFullYear();
const { rights, archive, contactEmail, rss } = translations.footer;
---
<footer class="border-t border-border-subtle bg-surface-base">
  <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-8 text-sm text-text-secondary md:flex-row md:items-center md:justify-between">
    <p>© {currentYear} Plocos. {rights}</p>
    <div class="flex flex-wrap gap-x-4 gap-y-2">
      <a href="/rss.xml" class="transition-colors hover:text-accent">{rss}</a>
      <a href="https://www.plocos.com" rel="noopener noreferrer" class="transition-colors hover:text-accent">
        {archive}
      </a>
      <a href={`mailto:${contactEmail}`} class="transition-colors hover:text-accent">
        {contactEmail}
      </a>
    </div>
  </div>
</footer>
