---
import { getTranslations, type Locale } from '../lib/i18n';
import { db, Comments, eq, and, desc } from 'astro:db';

interface Props {
  slug: string;
  locale: Locale;
  initialStatus?: 'pending' | 'success' | 'error' | null;
}

const { slug, locale, initialStatus = null } = Astro.props as Props;
const copy = getTranslations(locale).posts.comments;
const initialStatusText =
  initialStatus === 'pending'
    ? copy.pending
    : initialStatus === 'success'
      ? copy.success
      : initialStatus === 'error'
        ? copy.error
        : '';

const comments = await db
  .select()
  .from(Comments)
  .where(and(eq(Comments.postSlug, slug), eq(Comments.locale, locale), eq(Comments.approved, true)))
  .orderBy(desc(Comments.createdAt));

const dateFormatter = new Intl.DateTimeFormat(locale, {
  dateStyle: 'medium',
  timeStyle: 'short',
});
---
<section
  id="comments"
  class="mt-16 space-y-8 border-t border-border-subtle pt-8"
  data-comment-section
  data-slug={slug}
  data-locale={locale}
  data-message-pending={copy.pending}
  data-message-success={copy.success}
  data-message-error={copy.error}
  data-message-empty={copy.empty}
  data-initial-status={initialStatus ?? ''}
>
  <header class="space-y-3">
    <h2 class="text-xs font-semibold uppercase tracking-[0.35em] text-text-secondary opacity-80">
      {copy.heading}
    </h2>
    <p class="text-sm text-text-secondary">{copy.description}</p>
  </header>

  <form
    class="space-y-6 rounded-2xl border border-border-subtle bg-surface-muted p-6 shadow-contemplation"
    method="post"
    action="/api/comments"
    data-comment-form
    novalidate
  >
    <div class="grid gap-4 md:grid-cols-2">
      <div class="flex flex-col gap-2">
        <label for="comment-name" class="text-xs font-semibold uppercase tracking-[0.25em] text-text-secondary">
          {copy.nameLabel}
        </label>
        <input
          id="comment-name"
          name="name"
          type="text"
          required
          minlength="2"
          maxlength="120"
          autocomplete="name"
          class="rounded-xl border border-border-subtle bg-surface px-3 py-2 text-sm text-text-primary outline-none transition placeholder:text-text-secondary/80 focus:border-accent focus:ring-2 focus:ring-accent/20"
        />
      </div>
      <div class="flex flex-col gap-2">
        <label for="comment-email" class="text-xs font-semibold uppercase tracking-[0.25em] text-text-secondary">
          {copy.emailLabel}
        </label>
        <input
          id="comment-email"
          name="email"
          type="email"
          inputmode="email"
          maxlength="160"
          autocomplete="email"
          class="rounded-xl border border-border-subtle bg-surface px-3 py-2 text-sm text-text-primary outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/20"
        />
      </div>
    </div>

    <div class="flex flex-col gap-2">
      <label for="comment-message" class="text-xs font-semibold uppercase tracking-[0.25em] text-text-secondary">
        {copy.messageLabel}
      </label>
      <textarea
        id="comment-message"
        name="message"
        required
        minlength="8"
        maxlength="2000"
        rows="6"
        class="rounded-xl border border-border-subtle bg-surface px-3 py-2 text-sm text-prosy-body outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/20"
      ></textarea>
    </div>

    <div class="hidden" aria-hidden="true">
      <label class="sr-only" for="comment-website">Website</label>
      <input id="comment-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <input type="hidden" name="slug" value={slug} />
    <input type="hidden" name="locale" value={locale} />

    <p class="text-xs text-text-secondary/80">{copy.moderationNotice}</p>

    <div class="flex flex-col gap-3">
      <button
        type="submit"
        class="inline-flex w-full items-center justify-center rounded-full bg-accent px-6 py-3 text-sm font-semibold uppercase tracking-[0.25em] text-surface transition hover:bg-accent-strong focus:outline-none focus:ring-2 focus:ring-accent/30 disabled:cursor-not-allowed disabled:opacity-70"
        data-submit-button
      >
        {copy.submitLabel}
      </button>
      <p
        class="min-h-[1.5rem] text-sm text-text-secondary"
        role="status"
        aria-live="polite"
        data-status
        {...(initialStatus ? { 'data-state': initialStatus } : {})}
      >
        {initialStatusText}
      </p>
    </div>
  </form>

  <div class="space-y-4">
    <ul class="space-y-4" data-comments-list>
      {comments.map(comment => (
        <li class="overflow-hidden rounded-2xl border border-border-subtle bg-surface p-6 shadow-contemplation transition-all duration-300 ease-in-out hover:border-border hover:shadow-sm">
          <div class="flex items-center justify-between text-xs text-text-secondary/80">
            <span class="font-semibold text-text-primary">{comment.name}</span>
            <time class="text-xs">{dateFormatter.format(new Date(comment.createdAt))}</time>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-text-primary whitespace-pre-wrap">{comment.message}</p>
        </li>
      ))}
    </ul>
    <div data-load-more-container class="mt-6 text-center"></div>

    <p class="text-sm text-text-secondary" data-empty-state hidden={comments.length > 0}>{copy.empty}</p>
  </div>

  <template data-comment-template>
    <li class="overflow-hidden rounded-2xl border border-border-subtle bg-surface p-6 shadow-contemplation transition-all duration-300 ease-in-out hover:border-border hover:shadow-sm">
      <div class="flex items-center justify-between text-xs text-text-secondary/80">
        <span data-comment-author class="font-semibold text-text-primary"></span>
        <time data-comment-date class="text-xs" />
      </div>
      <p data-comment-message class="mt-3 text-sm leading-relaxed text-text-primary whitespace-pre-wrap"></p>
    </li>
  </template>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector('[data-comment-section]');
    if (!(section instanceof HTMLElement)) {
      console.warn('Comment section container not found');
      return;
    }

    const slug = section.dataset.slug ?? '';
    const locale = section.dataset.locale ?? 'es';
    const messages = {
      pending: section.dataset.messagePending ?? '',
      success: section.dataset.messageSuccess ?? '',
      error: section.dataset.messageError ?? '',
      empty: section.dataset.messageEmpty ?? '',
    };
    const initialStatus = section.dataset.initialStatus ?? '';

    const form = section.querySelector('form[data-comment-form]');
    const list = section.querySelector('[data-comments-list]');
    const emptyState = section.querySelector('[data-empty-state]');
    const status = section.querySelector('[data-status]');
    const submitButton = section.querySelector('[data-submit-button]');
    const template = section.querySelector('template[data-comment-template]');
    const loadMoreContainer = section.querySelector('[data-load-more-container]');

    if (!(form instanceof HTMLFormElement) || !(list instanceof HTMLElement) || !(template instanceof HTMLTemplateElement) || !(loadMoreContainer instanceof HTMLElement)) {
      console.warn('Comment form prerequisites missing');
      return;
    }
    
    const dateFormatter = Intl.DateTimeFormat(locale, {
      dateStyle: 'medium',
      timeStyle: 'short',
    });

    const currentUrl = new URL(window.location.href);
    const commentParam = currentUrl.searchParams.get('comment');
    if (commentParam && status instanceof HTMLElement) {
      const normalized = commentParam === 'pending' || commentParam === 'success' || commentParam === 'error' ? commentParam : '';
      if (normalized) {
        status.dataset.state = normalized;
        status.textContent = messages[normalized];
      }
      currentUrl.searchParams.delete('comment');
      window.history.replaceState({}, '', currentUrl);
    } else if (initialStatus && status instanceof HTMLElement) {
      status.dataset.state = initialStatus;
    }

    const COMMENTS_VISIBLE = 5;
    let commentItems = Array.from(list.children);

    function setupLoadMore() {
      commentItems.forEach((item, index) => {
        if (index >= COMMENTS_VISIBLE) {
          item.hidden = true;
        }
      });

      loadMoreContainer.replaceChildren();
      if (commentItems.length > COMMENTS_VISIBLE) {
        const button = document.createElement('button');
        const remaining = commentItems.length - COMMENTS_VISIBLE;
        button.textContent = `Cargar los ${remaining} comentarios restantes`;
        button.className = 'inline-flex items-center justify-center rounded-full border border-border-subtle bg-surface-muted px-6 py-3 text-sm font-semibold uppercase tracking-[0.25em] text-text-primary transition hover:bg-surface-hover focus:outline-none focus:ring-2 focus:ring-accent/30';
        button.onclick = () => {
          commentItems.forEach(item => {
            item.hidden = false;
          });
          loadMoreContainer.replaceChildren();
        };
        loadMoreContainer.appendChild(button);
      }
    }

    async function refreshComments() {
      try {
        const response = await fetch(`/api/comments.json?slug=${slug}&locale=${locale}`);
        if (!response.ok) {
          console.error('Failed to fetch comments');
          return;
        }
        const allComments = await response.json();
        
        list.replaceChildren();
        if (!allComments.length) {
          if (emptyState instanceof HTMLElement) {
            emptyState.textContent = messages.empty;
            emptyState.removeAttribute('hidden');
          }
          return;
        }

        if (emptyState instanceof HTMLElement) {
          emptyState.setAttribute('hidden', 'true');
        }

        const fragment = document.createDocumentFragment();
        for (const comment of allComments) {
          const commentElement = template.content.cloneNode(true);
          const author = commentElement.querySelector('[data-comment-author]');
          const date = commentElement.querySelector('[data-comment-date]');
          const message = commentElement.querySelector('[data-comment-message]');

          if (author instanceof HTMLElement) author.textContent = comment.name;
          if (date instanceof HTMLElement) date.textContent = dateFormatter.format(new Date(comment.createdAt));
          if (message instanceof HTMLElement) message.textContent = comment.message;
          
          fragment.appendChild(commentElement);
        }
        list.appendChild(fragment);

        commentItems = Array.from(list.children);
        setupLoadMore();

      } catch (error) {
        console.error('Error fetching comments:', error);
      }
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(submitButton instanceof HTMLButtonElement) || !(status instanceof HTMLElement)) return;

      submitButton.disabled = true;
      status.dataset.state = 'pending';
      status.textContent = messages.pending;

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());
      const response = await fetch('/api/comments', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        window.location.href = '/';
      } else {
        status.dataset.state = 'error';
        status.textContent = messages.error;
      }

      submitButton.disabled = false;
    });

    const channel = new BroadcastChannel(`comments-${slug}`);
    channel.onmessage = (event) => {
      if (event.data.type === 'comment-approved') {
        refreshComments();
      }
    };

    if (commentItems.length > 0) {
      setupLoadMore();
    }
  });
</script>
