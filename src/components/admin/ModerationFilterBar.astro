---
/**
 * Pill-shaped filter bar for the moderation queue.
 *
 * Props:
 *  - posts: list of unique postSlug values to populate the Post filter
 *  - locales: list of locale codes to populate the Language filter
 */
interface Props {
  posts: string[];
  locales: string[];
}

const { posts, locales } = Astro.props as Props;
---

<div
  class="moderation-filter-bar flex flex-wrap items-center gap-2"
  data-moderation-filter-bar
  role="toolbar"
  aria-label="Filtros de moderación"
>
  <div class="relative">
    <select
      data-filter="status"
      class="appearance-none rounded-full border border-border-subtle bg-surface px-4 py-2 pr-9 text-sm font-medium text-text-primary shadow-sm transition hover:border-border focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
      aria-label="Filtrar por estado"
    >
      <option value="">Estado: todos</option>
      <option value="pending">Pendiente</option>
      <option value="approved">Aprobado</option>
      <option value="rejected">Rechazado</option>
      <option value="spam">Spam</option>
    </select>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-text-secondary"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </div>

  <div class="relative">
    <select
      data-filter="locale"
      class="appearance-none rounded-full border border-border-subtle bg-surface px-4 py-2 pr-9 text-sm font-medium text-text-primary shadow-sm transition hover:border-border focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
      aria-label="Filtrar por idioma"
    >
      <option value="">Idioma: todos</option>
      {locales.map((loc) => (
        <option value={loc}>{loc === 'es' ? 'es-CO' : loc}</option>
      ))}
    </select>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-text-secondary"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </div>

  <div class="relative">
    <select
      data-filter="postSlug"
      class="appearance-none rounded-full border border-border-subtle bg-surface px-4 py-2 pr-9 text-sm font-medium text-text-primary shadow-sm transition hover:border-border focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
      aria-label="Filtrar por post"
    >
      <option value="">Post: todos</option>
      {posts.map((slug) => (
        <option value={slug}>{slug}</option>
      ))}
    </select>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-text-secondary"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </div>

  <button
    type="button"
    data-filter-clear
    class="ml-auto rounded-full border border-border-subtle bg-surface px-4 py-2 text-sm font-medium text-text-secondary transition hover:border-border hover:text-text-primary"
  >
    Limpiar filtros
  </button>
</div>
