---
/**
 * Individual comment card for the moderation masonry grid.
 * Static HTML — selection state and relative time are hydrated by
 * the inline script in src/pages/admin/comments.astro.
 */
type CommentStatus = 'pending' | 'approved' | 'rejected' | 'spam';

interface Props {
  id: number;
  postSlug: string;
  status: CommentStatus;
  locale: string;
  name: string;
  message: string;
  createdAt: Date | number | string;
}

const { id, postSlug, status, locale, name, message, createdAt } = Astro.props as Props;

const createdAtDate = createdAt instanceof Date ? createdAt : new Date(createdAt);
const createdAtIso = Number.isNaN(createdAtDate.getTime())
  ? new Date().toISOString()
  : createdAtDate.toISOString();

const initials = (name.trim().charAt(0) || '?').toUpperCase();

const statusStyles: Record<CommentStatus, { label: string; class: string }> = {
  pending: {
    label: 'Pendiente',
    class: 'bg-amber-100 text-amber-800 ring-1 ring-amber-200',
  },
  approved: {
    label: 'Aprobado',
    class: 'bg-emerald-100 text-emerald-800 ring-1 ring-emerald-200',
  },
  rejected: {
    label: 'Rechazado',
    class: 'bg-rose-100 text-rose-800 ring-1 ring-rose-200',
  },
  spam: {
    label: 'Spam',
    class: 'bg-red-100 text-red-800 ring-1 ring-red-200',
  },
};

const statusStyle = statusStyles[status] ?? statusStyles.pending;

const localeLabel = locale === 'es' ? 'es-CO' : locale.toUpperCase();
---

<article
  class="moderation-card relative w-full break-inside-avoid rounded-2xl border border-border-subtle bg-surface p-4 shadow-contemplation transition data-[selected='true']:opacity-60 md:w-[calc(50%-0.5rem)] xl:w-[calc(33.3333%-0.6667rem)]"
  data-comment-id={id}
  data-post-slug={postSlug}
  data-status={status}
  data-locale={locale}
  data-name={name}
  data-created-at={createdAtIso}
  data-moderation-card
>
  <label
    class="moderation-card__checkbox-wrap absolute right-3 top-3 z-10 inline-flex h-6 w-6 cursor-pointer items-center justify-center rounded-md bg-surface shadow-sm ring-1 ring-border-subtle"
    aria-label={`Seleccionar comentario de ${name}`}
  >
    <input
      type="checkbox"
      class="moderation-card__checkbox h-4 w-4 cursor-pointer rounded border-border-strong text-lime-500 accent-lime-500 focus:ring-lime-400"
      data-moderation-select
    />
  </label>

  <header class="mb-3 flex items-center gap-2 pr-9">
    <span
      class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-blue-100 text-blue-700"
      aria-hidden="true"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
        <line x1="7" y1="7" x2="7.01" y2="7"></line>
      </svg>
    </span>
    <span class="truncate text-sm font-medium text-text-primary" title={postSlug}>{postSlug}</span>
    <span
      class={`ml-auto inline-flex shrink-0 items-center rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide ${statusStyle.class}`}
    >
      {statusStyle.label}
    </span>
  </header>

  <p class="mb-4 whitespace-pre-wrap break-words text-base leading-relaxed text-text-primary">
    {message}
  </p>

  <footer class="flex flex-wrap items-center gap-2 text-sm text-text-secondary">
    <span
      class="moderation-card__avatar inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-xs font-semibold text-white"
      data-avatar-for={name}
      aria-hidden="true"
    >
      {initials}
    </span>
    <span class="font-medium text-text-primary">{name}</span>
    <time
      class="moderation-card__time text-xs text-text-secondary"
      datetime={createdAtIso}
      data-relative-time
    >
      {createdAtIso}
    </time>
    <span
      class="ml-auto inline-flex items-center gap-2 rounded-full bg-surface-muted px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-text-secondary"
    >
      {localeLabel}
    </span>
    <button
      type="button"
      class="moderation-card__delete inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-900 text-white transition hover:bg-rose-600 focus:outline-none focus:ring-2 focus:ring-rose-400 focus:ring-offset-2"
      aria-label={`Eliminar comentario de ${name}`}
      data-moderation-delete
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="3 6 5 6 21 6"></polyline>
        <path
          d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
        ></path>
      </svg>
    </button>
  </footer>
</article>
