---
/**
 * @component SiteHeader
 * @description Renderiza la cabecera principal del sitio para el pivote NQLV. Incluye el logo, la navegación a las 5
 * secciones del producto (Inicio / Nomás Que La Vida / Auditores / Repositorio / Contacto), un CTA destacado a
 * Suscripción, un enlace al blog legacy (plocos.blogspot.com), el conmutador de tema y el selector de idioma.
 *
 * @prop {string} [currentPath="/"] - La ruta actual de la URL para determinar el enlace activo.
 * @prop {string} locale - El locale actual para la internacionalización.
 */

import ThemeToggle from "./ThemeToggle.astro";
import SocialIcon from "./icons/SocialIcon.astro";
import { translations as allTranslations, defaultLocale } from "../lib/i18n";
import type { Locale } from "../lib/i18n";
import { createLocaleHref } from "../lib/routes";
import rawContactData from "../data/contact.json";
import { Show, UserButton } from "@clerk/astro/components";
import { getSignInPath } from "../lib/routeMatcher";
import { canContribute, getRoleFromClaims } from "../lib/access";

type SocialLink = { id: 'facebook' | 'instagram' | 'x'; label: string; url: string };

const { currentPath = "/", locale } = Astro.props as { currentPath?: string; locale: string };
const translations = allTranslations[locale as Locale];
const navItems = translations.navigation;
const normalisePath = (path: string) => path.replace(/\/+/g, '/').replace(/\/$/, '');
const activePath = normalisePath(currentPath);
const homeHref = createLocaleHref(locale as Locale);
const suscripcionHref = createLocaleHref(locale as Locale, translations.paths.suscripcion);
const navAriaLabel =
  locale === "es" ? "Navegación principal" : "Primary navigation";

const isActive = (href: string) => {
  const target = normalisePath(href);
  if (target === "/") {
    return activePath === "/";
  }
  return activePath.startsWith(target);
};

const stripLocalePrefix = (path: string) => {
  if (path === "/") {
    return "";
  }
  const trimmed = path.replace(/\/+$/, "");
  const withoutLeading = trimmed.replace(/^\//, "");
  const segments = withoutLeading.split("/").filter(Boolean);
  if (segments.length === 0) {
    return "";
  }
  if (locale !== defaultLocale && segments[0] === locale) {
    segments.shift();
  }
  return segments.join("/");
};

const computeLocaleHref = (targetLocale: Locale) => {
  const basePath = stripLocalePrefix(currentPath);
  const currentSegments = basePath ? basePath.split("/") : [];

  if (currentSegments.length === 0) {
    return createLocaleHref(targetLocale);
  }

  const toSegmentKey = (translations: any) => {
    const mapping = new Map<string, string>();
    Object.entries(translations.paths).forEach(([key, segment]) => {
      if (typeof segment === "string" && segment) mapping.set(segment, key as string);
    });
    return mapping;
  };
  const currentMapping = toSegmentKey(translations);
  const segmentKey = currentMapping.get(currentSegments[0]);
  if (segmentKey) {
    const targetTranslation = allTranslations[targetLocale];
    if (segmentKey && segmentKey in targetTranslation.paths) {
      const targetSegment = targetTranslation.paths[segmentKey as keyof typeof targetTranslation.paths];
      currentSegments[0] = targetSegment ?? currentSegments[0];
    }
  }

  const nextPath = currentSegments.join("/");
  return createLocaleHref(targetLocale, nextPath);
};

const languageOptions = [
  { code: "es", label: "Es", href: computeLocaleHref("es") },
  { code: "en", label: "En", href: computeLocaleHref("en") },
];

// Labels for the Suscripción CTA (separate from the regular nav).
const ctaLabel = locale === "es" ? "Suscríbete" : "Subscribe";
// Blog legacy link (external, opens new tab).
const blogLegacyHref = "https://plocos.blogspot.com";
const blogLegacyLabel = locale === "es" ? "Blog (archivo)" : "Blog (archive)";
// Social links loaded from the same data source as the footer.
const socialLinks = (rawContactData as { social: SocialLink[] }).social;
// Auth entry points (Clerk). Sign-in path is locale-aware, same as the middleware redirect.
const authLabels = translations.auth;
const signInHref = getSignInPath(homeHref);
const accountHref = createLocaleHref(locale as Locale, translations.paths.account);
// Member shortcuts by role (T26). Role comes from the Clerk session token, no DB query.
const role = getRoleFromClaims(Astro.locals.auth?.().sessionClaims);
const memberLinks = [
  ...(role ? [{ href: createLocaleHref(locale as Locale, translations.paths.book), label: locale === "es" ? "Leer el libro" : "Read the book" }] : []),
  ...(canContribute(role) ? [{ href: createLocaleHref(locale as Locale, translations.paths.repositorio), label: locale === "es" ? "Aportar" : "Contribute" }] : []),
];
---
<header class="site-header mb-4">
  <div class="header-spacer"></div>
  <div class="header-bar">
    <nav class="bg-surface-base fixed w-full z-20 top-0 start-0 border-b border-border-subtle">
      <div class="w-full flex flex-row flex-nowrap items-center justify-between p-4 gap-4">
        <!-- Logo a la izquierda -->
        <a href={homeHref} class="logo-link flex items-center shrink-0" aria-label="Logo de Plocos">
          <img src="/logo.svg" alt="Logo de Plocos" class="logo-mark h-20 w-20 md:h-24 md:w-24" />
        </a>

        <!-- Menú de navegación Desktop (centrado) -->
        <div class="hidden lg:flex items-center justify-center flex-1" id="navbar-desktop">
          <ul class="font-medium flex flex-row space-x-6 rtl:space-x-reverse">
            {navItems.map((item) => {
              const href = createLocaleHref(locale as Locale, item.path);
              const active = isActive(href);
              return (
                <li>
                  <a href={href} aria-current={active ? "page" : undefined} class={`inline-flex items-center rounded-full px-3.5 py-2 text-[0.95rem] text-text-primary transition-colors duration-200 hover:bg-surface-muted hover:text-accent ${active ? "text-accent font-semibold" : ""}`}>{item.label}</a>
                </li>
              );
            })}
          </ul>
        </div>

        <!-- Controles Derecha (Desktop) -->
        <div class="hidden md:flex items-center gap-2">
          <div class="hidden lg:flex items-center gap-0.5 pr-2 mr-1 border-r border-border-subtle">
            {socialLinks.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label}
                title={social.label}
                class="inline-flex h-9 w-9 items-center justify-center rounded-full text-text-secondary transition-all duration-200 hover:bg-surface-muted hover:text-accent hover:scale-110 hover:-translate-y-0.5"
              >
                <SocialIcon name={social.id} class="h-4 w-4" />
              </a>
            ))}
          </div>
          <a
            href={suscripcionHref}
            class="inline-flex items-center justify-center rounded-full bg-accent px-4 py-2 text-sm font-semibold uppercase tracking-widest text-surface-base shadow-md transition hover:bg-text-primary hover:text-surface-base"
          >
            {ctaLabel}
          </a>
          <Show when="signed-out">
            <a
              href={signInHref}
              aria-label={authLabels.signInLabel}
              title={authLabels.signInLabel}
              class="inline-flex items-center gap-1.5 rounded-full px-3 py-2 text-sm font-medium text-text-primary transition-colors duration-200 hover:bg-surface-muted hover:text-accent"
            >
              <svg aria-hidden="true" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.5 20.1a7.5 7.5 0 0 1 15 0A17.9 17.9 0 0 1 12 21.75c-2.68 0-5.22-.58-7.5-1.65Z"/></svg>
              <span class="hidden lg:inline">{authLabels.signInLabel}</span>
            </a>
          </Show>
          <Show when="signed-in">
            {memberLinks.map((link) => (
              <a
                href={link.href}
                class="hidden lg:inline-flex items-center rounded-full px-3 py-2 text-sm font-medium text-text-primary transition-colors duration-200 hover:bg-surface-muted hover:text-accent"
              >
                {link.label}
              </a>
            ))}
            <UserButton />
          </Show>
          <ThemeToggle />
          <div class="flex gap-1 ml-2">
            <a href={languageOptions[0].href} aria-label="Español" class={`rounded-full border border-border-subtle bg-surface-elevated p-1 transition hover:border-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 ${locale === 'es' ? 'ring-2 ring-accent' : ''}`}>
              <img src="/flags/co.svg" alt="Español" class="h-6 w-6" />
            </a>
            <a href={languageOptions[1].href} aria-label="English" class={`rounded-full border border-border-subtle bg-surface-elevated p-1 transition hover:border-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 ${locale === 'en' ? 'ring-2 ring-accent' : ''}`}>
              <img src="/flags/us.svg" alt="English" class="h-6 w-6" />
            </a>
          </div>
        </div>

        <!-- Controles Derecha (Mobile) -->
        <div class="flex md:hidden items-center gap-2">
          <a
            href={suscripcionHref}
            class="inline-flex items-center justify-center rounded-full bg-accent px-3 py-1.5 text-xs font-semibold uppercase tracking-widest text-surface-base shadow-md"
          >
            {ctaLabel}
          </a>
          <ThemeToggle />
          <button data-collapse-toggle="mobile-nav" type="button" class="hamburger-btn flex h-10 w-10 items-center justify-center rounded-full border border-border-subtle bg-surface-elevated text-text-primary transition hover:border-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2" aria-label="Abrir menú" aria-controls="mobile-nav" aria-expanded="false">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect y="5" width="24" height="2" rx="1" fill="currentColor" />
              <rect y="11" width="24" height="2" rx="1" fill="currentColor" />
              <rect y="17" width="24" height="2" rx="1" fill="currentColor" />
            </svg>
          </button>
        </div>
      </div>
    </nav>
    <!-- Overlay y menú hamburguesa -->
    <div id="mobile-nav-overlay" class="fixed inset-0 z-40 bg-black/40 backdrop-blur-sm transition-opacity duration-300 opacity-0 pointer-events-none md:hidden"></div>
    <nav
      id="mobile-nav"
      class="mobile-nav hidden fixed inset-0 z-50 flex-col justify-start items-stretch h-screen w-screen bg-surface-base border-none shadow-2xl p-6 pt-[var(--header-height)] transition-transform duration-300 md:hidden"
      aria-label={navAriaLabel}
    >
      <!-- Solo el botón de cerrar menú, no hamburguesa -->
      <button type="button" aria-label="Cerrar menú" class="self-end mb-4 text-gray-500 hover:text-blue-600 focus:outline-none" data-close-mobile-nav>
        <svg aria-hidden="true" class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
      <ul class="flex flex-col gap-4 text-lg font-medium w-full">
        {
          navItems.map((item) => {
            const href = createLocaleHref(locale as Locale, item.path);
            const active = isActive(href);
            return (
              <li class="w-full">
                <a href={href} aria-current={active ? "page" : undefined} class={`block w-full rounded border px-4 py-3 transition ${active ? "border-accent bg-accent/10 text-accent font-bold" : "border-border-subtle bg-surface-elevated text-text-primary hover:border-accent hover:text-accent"}`}>{item.label}</a>
              </li>
            );
          })
        }
        <Show when="signed-out">
          <li class="w-full">
            <a href={signInHref} class="block w-full rounded border border-accent px-4 py-3 text-accent font-semibold transition hover:bg-accent/10">
              {authLabels.signInLabel}
            </a>
          </li>
        </Show>
        <Show when="signed-in">
          {memberLinks.map((link) => (
            <li class="w-full">
              <a href={link.href} class="block w-full rounded border border-accent px-4 py-3 text-accent font-semibold transition hover:bg-accent/10">
                {link.label}
              </a>
            </li>
          ))}
          <li class="w-full">
            <a href={accountHref} class="block w-full rounded border border-border-subtle bg-surface-elevated px-4 py-3 text-text-primary transition hover:border-accent hover:text-accent">
              {authLabels.accountLabel}
            </a>
          </li>
        </Show>
      </ul>
    </nav>
  </div>
</header>
<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const hamburgerBtn = document.querySelector("button[data-collapse-toggle='mobile-nav']");
    const mobileNav = document.getElementById("mobile-nav");
    const overlay = document.getElementById("mobile-nav-overlay");
    const closeBtn = document.querySelector("[data-close-mobile-nav]");

    if (!hamburgerBtn || !mobileNav || !overlay || !closeBtn) {
      return;
    }

    const navLinks = mobileNav.querySelectorAll("a");

    function openMenu() {
      mobileNav.classList.remove("hidden");
      mobileNav.classList.add("flex");
      overlay.classList.remove("opacity-0", "pointer-events-none");
      overlay.classList.add("opacity-100");
      hamburgerBtn.setAttribute("aria-expanded", "true");
    }

    function closeMenu() {
      mobileNav.classList.add("hidden");
      mobileNav.classList.remove("flex");
      overlay.classList.add("opacity-0", "pointer-events-none");
      overlay.classList.remove("opacity-100");
      hamburgerBtn.setAttribute("aria-expanded", "false");
    }

    hamburgerBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        openMenu();
    });
    closeBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        closeMenu();
    });
    overlay.addEventListener("click", closeMenu);
    navLinks.forEach(link => {
      link.addEventListener("click", closeMenu);
    });
  });
</script>
  <style>
    /* Forzar ocultamiento del botón hamburguesa en escritorio */
    @media (min-width: 768px) {
      .hamburger-btn {
        display: none !important;
      }
    }
  .site-header {
    /* Logo desktop = 6rem (96px) + 2 * p-4 (16px) = 8rem (128px) */
    --header-height: 8rem;
  }

  .site-header .header-spacer {
    height: var(--header-height);
  }

  .site-header .header-bar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 60;
    transition:
      box-shadow 200ms ease,
      background-color 200ms ease;
    box-shadow: none;
  }

  .site-header.is-scrolled .header-bar {
    box-shadow: 0 18px 30px -26px rgba(78, 61, 131, 0.6);
  }

  .site-header .logo-link .logo-mark {
    transition: transform 200ms ease;
  }

  .site-header.is-scrolled .logo-link .logo-mark {
    transform: scale(0.92);
  }

  @media (max-width: 767px) {
    .site-header {
      /* Logo mobile = 5rem (80px) + 2 * p-4 (16px) = 7rem (112px) */
      --header-height: 7rem;
    }
  }
</style>
