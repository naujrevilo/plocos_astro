---
import "../styles/tailwind.css";
import "instantsearch.css/themes/algolia.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { defaultLocale, getTranslations, type Locale } from "../lib/i18n";
import { GoogleAnalytics } from "astro-google-analytics";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
}

const { title, description, image, canonicalUrl } = Astro.props as Props;
const currentPath = Astro.url.pathname;
const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const translations = getTranslations(locale);
const siteTitle = translations.site.title;
const defaultDescription = translations.site.description;
const pageTitle = title ?? siteTitle;
const metaDescription = description ?? defaultDescription;
const analyticsId = import.meta.env.ANALYTICS_ID;
---

<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`/favicon.svg?v=${new Date().getTime()}`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content="#f5f1e6" />
    {image && <meta property="og:image" content={image} />}
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <script is:inline>
      (function () {
        const storageKey = "plocos-theme";
        const doc = document.documentElement;
        try {
          const saved = localStorage.getItem(storageKey);
          const mode = saved === "light" || saved === "dark" ? saved : "system";
          doc.dataset.themePreference = mode;
          if (mode === "light") {
            doc.setAttribute("data-theme", "light");
          } else if (mode === "dark") {
            doc.setAttribute("data-theme", "dark");
          } else {
            doc.removeAttribute("data-theme");
          }
        } catch (error) {
          doc.dataset.themePreference = "system";
          doc.removeAttribute("data-theme");
        }
      })();
    </script>
    {analyticsId && <GoogleAnalytics id={analyticsId} />}
    <script src="/node_modules/flowbite/dist/flowbite.min.js" defer></script>
  </head>
  <body
    class="flex min-h-screen flex-col bg-surface-base text-text-primary transition-colors duration-200"
  >
    <SiteHeader currentPath={currentPath} locale={locale} />
    <main class="flex-1">
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>
