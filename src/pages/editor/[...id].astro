---
/**
 * @file src/pages/editor/[...id].astro
 * @description This page provides an interface for editing an existing blog post.
 * @see /src/pages/api/save-post.ts
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { id: post.id },
  }));
}

const { id } = Astro.params;
if (!id) return Astro.redirect('/editor');

const post = await getEntry('posts', id);
if (!post) return Astro.redirect('/editor');

const pubDate = post.data.pubDate ? new Date(post.data.pubDate).toLocaleDateString('es-ES') : '';
---

<BaseLayout title={`Editar: ${post.data.title}`}>
  <div class="container mx-auto px-4 py-8 max-w-4xl">
    <div class="mb-6">
      <a href="/editor" class="text-blue-600 hover:underline">← Volver al listado</a>
    </div>

    <h1 class="text-3xl font-bold mb-2">Editar Publicación</h1>
    <p class="text-sm text-gray-600 mb-6">Archivo: {id}.md · Publicado: {pubDate}</p>
    
    <form id="editForm" class="space-y-6">
      <input type="hidden" name="id" value={id} />
      
      <div>
        <label class="block font-semibold mb-2">Título</label>
        <input 
          type="text" 
          name="title" 
          value={post.data.title}
          required
          class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-blue-500 focus:border-transparent"
        />
      </div>

      <div>
        <label class="block font-semibold mb-2">Resumen</label>
        <textarea 
          name="summary" 
          rows="4"
          class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-blue-500 focus:border-transparent"
        >{post.data.summary || ''}</textarea>
        <p class="text-xs text-gray-500 mt-1">Breve descripción para SEO y vistas previas</p>
      </div>

      <div>
        <label class="block font-semibold mb-2">Contenido (Markdown)</label>
        <textarea 
          name="body" 
          rows="24"
          required
          class="w-full border border-gray-300 rounded-lg px-4 py-3 font-mono text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent"
        >{post.body}</textarea>
        <p class="text-xs text-gray-500 mt-1">Soporta Markdown completo</p>
      </div>

      <div class="flex gap-3 pt-4 border-t">
        <button 
          type="submit" 
          class="bg-blue-600 text-white px-8 py-3 rounded-lg hover:bg-blue-700 font-semibold transition"
        >
          💾 Guardar Cambios
        </button>
        <a 
          href="/editor" 
          class="bg-gray-200 text-gray-700 px-8 py-3 rounded-lg hover:bg-gray-300 font-semibold transition inline-block"
        >
          Cancelar
        </a>
        <div id="status" class="flex items-center ml-4 text-sm font-medium"></div>
      </div>
    </form>
  </div>

  <script>
    const formElement = document.getElementById('editForm');
    const statusElement = document.getElementById('status');

    if (formElement instanceof HTMLFormElement && statusElement instanceof HTMLElement) {
      formElement.addEventListener('submit', async (e) => {
        e.preventDefault();

        statusElement.textContent = '⏳ Guardando...';
        statusElement.className = 'flex items-center ml-4 text-sm font-medium text-blue-600';

        try {
          const formData = new FormData(formElement);
          const response = await fetch('/api/save-post', {
            method: 'POST',
            body: formData
          });

          const result = await response.json();

          if (response.ok) {
            statusElement.textContent = '✓ Guardado exitosamente';
            statusElement.className = 'flex items-center ml-4 text-sm font-medium text-green-600';

            // Redirigir después de 1 segundo
            setTimeout(() => {
              window.location.href = '/editor';
            }, 1000);
          } else {
            statusElement.textContent = `✗ Error: ${result.error}`;
            statusElement.className = 'flex items-center ml-4 text-sm font-medium text-red-600';
          }
        } catch (error) {
          statusElement.textContent = '✗ Error de conexión';
          statusElement.className = 'flex items-center ml-4 text-sm font-medium text-red-600';
          console.error(error);
        }
      });
    } else {
      console.error('Editor form not found');
    }
  </script>
</BaseLayout>
