---
/**
 * /auditores — Sec Auditores
 *
 * Salón de la fama intelectual. Exhibe CVs resumidos de usuarios que
 * conquistaron el rango de Auditor. La DB y el panel de cuenta aún no
 * están conectados (T08 mockups); los datos mostrados son placeholders
 * representativos del contrato visual que tendrá.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { defaultLocale, getTranslations, type Locale } from '../../lib/i18n';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const translations = getTranslations(locale);
const isES = locale === 'es';

type AuditorEntry = {
  name: string;
  handle: string;
  bio: string;
  ascentionYear: number;
  emailVisible: boolean;
  email?: string;
};

// Placeholder data — los Auditores reales vendrán de la DB una vez T08 + T22
// estén conectados al schema users/auditorProfiles.
const PLACEHOLDER_AUDITORS: AuditorEntry[] = isES
  ? [
      {
        name: 'Por anunciar',
        handle: '@primer-auditor',
        bio: 'Próximamente publicaremos los CVs de los Auditores que se conquisten el rango honorífico a través de refutaciones al canon. Sus perfiles incluirán fotografía, formación y el argumento que les otorgó el rango.',
        ascentionYear: 2026,
        emailVisible: false,
      },
    ]
  : [
      {
        name: 'To be announced',
        handle: '@first-auditor',
        bio: 'We will soon publish the CVs of those Auditors who earn the honorific rank through rebuttals to the canon. Their profiles will include photography, background, and the argument that earned them the rank.',
        ascentionYear: 2026,
        emailVisible: false,
      },
    ];
---
<BaseLayout
  title={isES ? 'Auditores · Plocos' : 'Auditors · Plocos'}
  description={isES
    ? 'Salón de la fama intelectual. Exhibe los currículum vitae resumidos de cada usuario que ha conquistado el rango de Auditor.'
    : 'Hall of intellectual fame. Showcases the abbreviated CVs of each user who has earned the Auditor rank.'}
>
  <article class="mx-auto max-w-4xl space-y-12 px-4 py-16 text-text-secondary">
    <header class="space-y-4">
      <p class="text-xs font-semibold uppercase tracking-[0.35em] text-accent">
        {isES ? 'Sección 3 · Salón de la fama' : 'Section 3 · Hall of fame'}
      </p>
      <h1 class="text-4xl font-bold tracking-tight text-text-primary md:text-5xl">
        {isES ? 'Auditores' : 'Auditors'}
      </h1>
      <p class="text-lg leading-relaxed text-text-secondary/90 max-w-2xl">
        {isES
          ? 'Este espacio opera como un salón de la fama intelectual. Previa autorización expresa, se exhibirá un currículum vitae (CV) resumido de cada usuario que haya conquistado el rango de Auditor, incluyendo su fotografía, nombres y correo electrónico. Esta sección gamifica la experiencia, convirtiendo el rigor lógico en capital social visible.'
          : 'This space operates as a hall of intellectual fame. With prior authorisation, the abbreviated CV of each user who has earned the Auditor rank is exhibited, including their photograph, names, and email address. This section gamifies the experience, turning logical rigour into visible social capital.'}
      </p>
    </header>

    <section class="rounded-3xl border border-border-subtle bg-surface-elevated p-8 space-y-4">
      <h2 class="text-xl font-semibold text-text-primary">
        {isES ? '¿Cómo se gana el rango?' : 'How is the rank earned?'}
      </h2>
      <p class="leading-relaxed">
        {isES
          ? 'El rango de Auditor no se vende, se conquista. Un Colaborador asciende a Auditor únicamente si sus refutaciones obligan a reescribir la obra. Cuatro o más aportes que alteren el canon otorgan el rango por un año; dos o más por año subsiguiente lo renuevan. La insignia pública del rango es el reconocimiento moral dentro del Repositorio.'
          : 'The Auditor rank is not for sale; it is earned. A Collaborator ascends to Auditor only if their rebuttals compel a rewriting of the work. Four or more contributions that alter the canon grant the rank for one year; two or more in each subsequent year renew it. The public badge of the rank is the moral recognition within the Repository.'}
      </p>
    </section>

    <section class="space-y-6">
      <h2 class="text-2xl font-semibold text-text-primary">
        {isES ? 'Auditores vigentes' : 'Current auditors'}
      </h2>
      <ul class="space-y-6">
        {PLACEHOLDER_AUDITORS.map((auditor) => (
          <li class="rounded-3xl border border-border-subtle bg-surface-elevated p-6 flex flex-col sm:flex-row gap-4">
            <div class="shrink-0 h-24 w-24 rounded-full bg-accent/10 border border-accent/30 flex items-center justify-center text-2xl text-accent">
              {auditor.name.split(' ').map((p) => p[0]).join('').slice(0, 2)}
            </div>
            <div class="flex-1 space-y-2">
              <div>
                <h3 class="text-xl font-semibold text-text-primary">
                  {auditor.name}
                </h3>
                <p class="text-sm text-text-secondary/80 font-mono">
                  {auditor.handle}
                </p>
              </div>
              <p class="text-sm leading-relaxed">{auditor.bio}</p>
              <p class="text-xs text-text-secondary/70">
                {isES ? 'Año de ascenso:' : 'Ascention year:'} {auditor.ascentionYear}
                {auditor.emailVisible && auditor.email && (
                  <>
                    {' · '}
                    <a href={`mailto:${auditor.email}`} class="text-accent hover:underline">
                      {auditor.email}
                    </a>
                  </>
                )}
              </p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  </article>
</BaseLayout>
