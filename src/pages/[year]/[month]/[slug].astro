---
import { getPublishedPosts, getPostLocale } from '@/lib/posts';
import { defaultLocale, getTranslations, type Locale } from '@/lib/i18n';
import { createLocaleHref } from '@/lib/routes';

interface Props {
  slug: string;
  locale: Locale;
}

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return posts.map((post) => {
    const date = post.data.pubDate;
    const year = String(date.getUTCFullYear());
    const month = String(date.getUTCMonth() + 1).padStart(2, '0');
    const slug = post.slug.split('/').pop() ?? post.slug;

    return {
      params: { year, month, slug },
      props: {
        slug: post.slug,
        locale: getPostLocale(post),
      },
    };
  });
}

function buildPostRedirectHref(requestedLocale: Locale, props: Props) {
  const targetLocale = requestedLocale === props.locale ? requestedLocale : props.locale;
  const translations = getTranslations(targetLocale);
  const postsPath = `${translations.paths.posts}/${props.slug}`;
  return createLocaleHref(targetLocale, postsPath);
}

const props = Astro.props as Props;
const requestLocale = (Astro.currentLocale ?? defaultLocale) as Locale;
const redirectHref = buildPostRedirectHref(requestLocale, props);

if (!redirectHref) {
  throw new Error('Unable to resolve redirect target for legacy post route.');
}

return Astro.redirect(redirectHref);
---
