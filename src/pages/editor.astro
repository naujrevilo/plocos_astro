---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => 
  new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const totalPosts = sortedPosts.length;
---

<BaseLayout title="Editor de Publicaciones">
  <div class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="text-4xl font-bold mb-2">📝 Editor Local</h1>
      <p class="text-gray-600">Edita tus publicaciones directamente en modo desarrollo</p>
      <p class="text-sm text-gray-500 mt-2">Total: {totalPosts} publicaciones</p>
    </div>
    
    <div class="grid gap-3">
      {sortedPosts.map(post => {
        const pubDate = new Date(post.data.pubDate).toLocaleDateString('es-ES', {
          year: 'numeric',
          month: 'short',
          day: 'numeric'
        });
        const isDraft = post.data.draft;
        const lang = post.data.language || 'es';
        
        return (
          <a 
            href={`/editor/${post.id}`} 
            class="block border border-gray-200 rounded-lg p-4 hover:border-blue-500 hover:shadow-md transition group"
          >
            <div class="flex items-start justify-between">
              <div class="flex-1 min-w-0">
                <h2 class="text-lg font-semibold group-hover:text-blue-600 transition truncate">
                  {post.data.title}
                </h2>
                <div class="flex items-center gap-3 text-sm text-gray-600 mt-1">
                  <span>📅 {pubDate}</span>
                  <span>🌐 {lang.toUpperCase()}</span>
                  {isDraft && <span class="bg-yellow-100 text-yellow-800 px-2 py-0.5 rounded text-xs font-medium">Borrador</span>}
                </div>
                {post.data.summary && (
                  <p class="text-sm text-gray-600 mt-2 line-clamp-2">
                    {post.data.summary}
                  </p>
                )}
              </div>
              <div class="ml-4 text-gray-400 group-hover:text-blue-500 transition">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>
