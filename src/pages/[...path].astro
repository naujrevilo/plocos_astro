---
/**
 * @file src/pages/[...path].astro
 * @description This page handles legacy URL redirection for blog posts.
 * It captures a slug from the URL, finds the corresponding post, and issues a
 * 301 permanent redirect to the correct new URL format (`/blog/[slug]`).
 * This is crucial for SEO and maintaining link equity from old URLs.
 * If no matching post is found, Astro's default 404 page is rendered.
 *
 * @see getCollection - Used to fetch all posts for slug matching.
 * @see Astro.redirect - Used to perform the 301 redirect.
 */
import { getCollection } from 'astro:content';

const { path } = Astro.params;

// The path could be '2025/flotar-o-navegar-hacia-una-realidad-de.md'
// or '2025/flotar-o-navegar-hacia-una-realidad-de'
// We just want the last part as the slug.
const slugFragment = path?.split('/').filter(segment => segment).pop()?.replace('.md', '');

if (slugFragment) {
    const posts = await getCollection('posts');
  // Find a post where the slug *ends with* the fragment.
  // This is safer than an exact match if there were nested folders.
    const post = posts.find(p => p.id === slugFragment);

  if (post) {
        return Astro.redirect(`/blog/${post.id}`, 301); // 301 Permanent Redirect
  }
}

// If no slug is found or no post matches, Astro will render the 404 page by default.
// We don't need to return anything.
---