---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { defaultLocale, getTranslations, type Locale } from '../../lib/i18n';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const translations = getTranslations(locale);
const about = translations.about;
---
<BaseLayout title={about.metaTitle} description={about.metaDescription}>
  <section class="mx-auto max-w-3xl space-y-6 px-4 py-16 text-text-secondary">
    <h1 class="text-4xl font-bold tracking-tight text-text-primary">{about.title}</h1>
    {about.paragraphs.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
    <div class="rounded-3xl border border-border-subtle bg-surface-elevated p-6 text-sm text-text-secondary">
      <h2 class="text-lg font-semibold text-text-primary">{about.principlesHeading}</h2>
      <ul class="mt-3 space-y-2">
        {about.principles.map((principle) => (
          <li>{principle}</li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
