---
/**
 * @file src/pages/blog/page/[page].astro
 * @description This page displays a paginated list of blog posts for a specific page number.
 * @see /src/components/PostCard.astro
 * @see /src/pages/blog/index.astro
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { defaultLocale, getTranslations, type Locale } from '../../../lib/i18n';
import { createLocaleHref } from '../../../lib/routes';
import { paginate, type PaginationResult } from '../../../lib/pagination';

const PAGE_SIZE = 6;

export async function getStaticPaths() {
  const allPosts = await getCollection('posts', ({ data }) => data.draft === false);
  
  const postsByLanguage: Record<string, any[]> = {};
  allPosts.forEach(post => {
    const postLanguage = post.data.language || defaultLocale;
    if (!postsByLanguage[postLanguage]) {
      postsByLanguage[postLanguage] = [];
    }
    postsByLanguage[postLanguage].push(post);
  });

  let maxPageCount = 0;
  for (const lang in postsByLanguage) {
    const pageCount = Math.ceil(postsByLanguage[lang].length / PAGE_SIZE);
    if (pageCount > maxPageCount) {
      maxPageCount = pageCount;
    }
  }

  const paths = [];
  for (let i = 1; i <= maxPageCount; i++) {
    paths.push({ params: { page: i.toString() } });
  }
  
  return paths;
}

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const { page: pageParam } = Astro.params;
const currentPage = parseInt(pageParam, 10);

const allPosts = await getCollection('posts', ({ data }) => {
  const postLanguage = data.language || defaultLocale;
  return data.draft === false && postLanguage === locale;
});
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const page: PaginationResult<CollectionEntry<'posts'>> = paginate(sortedPosts, currentPage, PAGE_SIZE);

const translations = getTranslations(locale);
const blog = translations.blog;

const createPageHref = (page: number) =>
  page === 1
    ? createLocaleHref(locale, translations.paths.blog)
    : createLocaleHref(locale, `${translations.paths.blog}/page/${page}`);

const prevHref = page.currentPage > 1 ? createPageHref(page.currentPage - 1) : null;
const nextHref = page.currentPage < page.totalPages ? createPageHref(page.currentPage + 1) : null;
---
<BaseLayout title={blog.metaTitle} description={blog.metaDescription}>
  <section class="mx-auto flex max-w-6xl flex-col gap-10 px-4 py-16">
    <header class="max-w-3xl space-y-4">
      <h1 class="text-4xl font-bold tracking-tight text-text-primary">{blog.title}</h1>
      <p class="text-lg leading-relaxed text-text-secondary">
        {blog.description}
      </p>
    </header>

  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {page.pageItems.map((post: CollectionEntry<'posts'>) => (
        <PostCard post={post} />
      ))}
    </div>

    {page.totalPages > 1 && (
      <nav aria-label={blog.pagination.ariaLabel} class="flex justify-center w-full">
        <div class="inline-flex rounded-lg shadow-xs border border-border-subtle bg-surface-elevated" role="group">
          <a href={prevHref ?? '#'} aria-label={blog.pagination.previous} class={`inline-flex items-center justify-center rounded-s-lg border-r border-border-subtle px-3 h-9 text-sm font-medium text-text-secondary bg-surface-base transition hover:bg-accent hover:text-surface-base focus:outline-none focus-visible:ring-2 focus-visible:ring-accent${!prevHref ? ' opacity-50 pointer-events-none' : ''}`}
            aria-disabled={!prevHref}
          >
            <span class="sr-only">{blog.pagination.previous}</span>
            <svg class="w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 19-7-7 7-7"/></svg>
          </a>
          <span class="inline-flex items-center justify-center px-4 h-9 text-sm font-bold text-accent bg-surface-elevated">{page.currentPage} / {page.totalPages}</span>
          <a href={nextHref ?? '#'} aria-label={blog.pagination.next} class={`inline-flex items-center justify-center rounded-e-lg border-l border-border-subtle px-3 h-9 text-sm font-medium text-text-secondary bg-surface-base transition hover:bg-accent hover:text-surface-base focus:outline-none focus-visible:ring-2 focus-visible:ring-accent${!nextHref ? ' opacity-50 pointer-events-none' : ''}`}
            aria-disabled={!nextHref}
          >
            <span class="sr-only">{blog.pagination.next}</span>
            <svg class="w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 5 7 7-7 7"/></svg>
          </a>
        </div>
      </nav>
    )}
  </section>
</BaseLayout>
