---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { defaultLocale, getTranslations, type Locale } from '../../lib/i18n';
import SocialIcon from '../../components/icons/SocialIcon.astro';
import rawContactData from '../../data/contact.json';

type SocialId = 'facebook' | 'instagram' | 'x';

type SocialLink = {
  id: SocialId;
  label: string;
  url: string;
};

type ContactData = {
  email: string;
  social: SocialLink[];
};

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const translations = getTranslations(locale);
const contact = translations.contact;
const contactData = rawContactData as ContactData;
const emailLabel = contact.emailLabel;
const cardClasses = 'rounded-3xl border border-border-subtle bg-surface-elevated px-6 py-5';

const socialLinks = contactData.social;
const socialAnchorClass =
  'group flex items-center gap-3 rounded-full border border-border-subtle px-4 py-2 text-sm text-text-primary transition hover:border-accent hover:text-text-primary hover:shadow-contemplation';
const inputClasses =
  'w-full rounded-xl border border-border-subtle bg-surface-base px-4 py-3 text-text-primary shadow-sm transition focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/40';
const buttonClasses =
  'inline-flex items-center justify-center rounded-full bg-accent px-6 py-3 text-sm font-semibold text-surface-base transition hover:bg-accent/90 focus:outline-none focus:ring-2 focus:ring-accent/40';
---
<BaseLayout title={contact.metaTitle} description={contact.metaDescription}>
  <section class="mx-auto max-w-3xl space-y-8 px-4 py-16 text-text-secondary">
    <header class="space-y-3">
      <h1 class="text-4xl font-bold tracking-tight text-text-primary">{contact.title}</h1>
      <p>{contact.intro}</p>
    </header>

    <div class={cardClasses}>
      <h2 class="text-lg font-semibold text-text-primary">{contact.channelsHeading}</h2>
      <ul class="mt-3 space-y-3 text-sm">
        <li>
          <span class="font-semibold text-text-primary">{emailLabel}:</span>
          <a class="ml-2 text-text-accent underline decoration-transparent transition hover:decoration-accent" href={`mailto:${contactData.email}`}>
            {contactData.email}
          </a>
        </li>
      </ul>
    </div>

    <div class={cardClasses}>
      <h2 class="text-lg font-semibold text-text-primary">Realizar un pago</h2>
      <div id="paypal-container-L9HZ7KPD7S28A" class="min-w-[200px] mt-4"></div>
    </div>


    <div class={cardClasses}>
      <h2 class="text-lg font-semibold text-text-primary">{contact.formHeading}</h2>
      <p class="mt-3 text-sm">{contact.formDescription}</p>
      <form
        name="contact"
        method="post"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="mt-5 space-y-4"
      >
        <input type="hidden" name="form-name" value="contact" />
        <input type="hidden" name="locale" value={locale} />
        <p class="hidden">
          <label>
            {contact.formSpamLabel}
            <input name="bot-field" />
          </label>
        </p>
        <div>
          <label class="mb-2 block text-sm font-semibold text-text-primary" for="contact-name">
            {contact.formNameLabel}
          </label>
          <input id="contact-name" name="name" type="text" class={inputClasses} required autocomplete="name" />
        </div>
        <div>
          <label class="mb-2 block text-sm font-semibold text-text-primary" for="contact-email">
            {contact.formEmailLabel}
          </label>
          <input
            id="contact-email"
            name="email"
            type="email"
            class={inputClasses}
            required
            autocomplete="email"
          />
        </div>
        <div>
          <label class="mb-2 block text-sm font-semibold text-text-primary" for="contact-message">
            {contact.formMessageLabel}
          </label>
          <textarea
            id="contact-message"
            name="message"
            class={`${inputClasses} min-h-[160px] resize-y`}
            required
          ></textarea>
        </div>
        <div class="space-y-3">
          <button type="submit" class={buttonClasses}>{contact.formSubmitLabel}</button>
          <p class="text-xs text-text-secondary/80">{contact.formPrivacy}</p>
        </div>
      </form>
    </div>

    <div class={cardClasses}>
      
      <div id="paypal-container-L9HZ7KPD7S28A" class="mt-4"></div>

    </div>

    <div class={cardClasses}>
      <h2 class="text-lg font-semibold text-text-primary">{contact.socialHeading}</h2>
      <p class="mt-3 text-sm">{contact.socialDescription}</p>
      <ul class="mt-4 flex flex-wrap gap-3 text-sm">
        {socialLinks.map((social) => (
          <li>
            <a
              class={socialAnchorClass}
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-surface-muted text-text-primary transition group-hover:bg-accent group-hover:text-surface-base">
                <SocialIcon name={social.id} />
              </span>
              <span class="font-medium">{social.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <p class="text-sm opacity-80">{contact.note}</p>
  </section>
<script is:inline src="https://www.paypal.com/sdk/js?client-id=BAAutVLDry6FJf2iLeWFIYBf66y2A7oy_Z9SD79AJ8jhv9oeV71VK46adlOYMqyCWoJEw8l3MngbRig2aA&components=hosted-buttons&disable-funding=venmo&currency=USD"></script>
<script is:inline>
  paypal.HostedButtons({
    hostedButtonId: "L9HZ7KPD7S28A",
  }).render("#paypal-container-L9HZ7KPD7S28A");
</script>
</BaseLayout>

<script is:inline src="https://www.paypal.com/sdk/js?client-id=BAAutVLDry6FJf2iLeWFIYBf66y2A7oy_Z9SD79AJ8jhv9oeV71VK46adlOYMqyCWoJEw8l3MngbRig2aA&components=hosted-buttons&disable-funding=venmo&currency=USD"></script>
<script is:inline>
  paypal.HostedButtons({
    hostedButtonId: "L9HZ7KPD7S28A",
  }).render("#paypal-container-L9HZ7KPD7S28A");
</script>
