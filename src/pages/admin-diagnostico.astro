---
// Página de acceso al admin de TinaCMS (diagnóstico)
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TinaCMS Diagnóstico</title>
  <style>
    body { margin: 0; padding: 0; font-family: system-ui, -apple-system, sans-serif; background: #f5f5f5; }
    .container { max-width: 600px; margin: 80px auto; padding: 40px; background: white; border-radius: 12px; box-shadow: 0 2px 20px rgba(0,0,0,0.1); text-align: center; }
    h1 { color: #333; margin-bottom: 16px; }
    p { color: #666; line-height: 1.6; margin-bottom: 24px; }
    .status { padding: 12px; border-radius: 8px; margin-bottom: 24px; background: #f0f9ff; border: 1px solid #0ea5e9; color: #0c4a6e; }
    .status.error { background: #fef2f2; border: 1px solid #ef4444; color: #7f1d1d; }
    .status.success { background: #f0fdf4; border: 1px solid #22c55e; color: #14532d; }
    .btn { display: inline-block; padding: 12px 24px; background: #4e3d83; color: white; text-decoration: none; border-radius: 8px; font-weight: 500; transition: background 0.2s; }
    .btn:hover { background: #3d2d6a; }
    .info { margin-top: 32px; padding-top: 32px; border-top: 1px solid #e5e7eb; font-size: 14px; color: #6b7280; }
    .loader { border: 3px solid #f3f3f3; border-top: 3px solid #4e3d83; border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; margin: 20px auto; }
    @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
  </style>
</head>
<body>
  <div class="container">
  <h1>🦙 Diagnóstico TinaCMS</h1>
    <div id="status" class="status">
      <div class="loader"></div>
      <p>Verificando conexión con el servidor TinaCMS...</p>
    </div>
    <div id="content"></div>
    <div class="info">
      <p><strong>Modo de desarrollo local</strong></p>
      <p>El servidor TinaCMS debe estar corriendo en <code>localhost:4001</code></p>
      <p>Ejecuta: <code>pnpm tinacms:dev</code></p>
    </div>
  </div>

  <script>
    const TINA_URL = 'http://localhost:4001';
  const statusEl = document.getElementById('status');
  const contentEl = document.getElementById('content');

    async function checkTinaServer() {
      try {
        const response = await fetch(`${TINA_URL}/graphql`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ query: '{ __typename }' })
        });
        if (response.ok) {
          // @ts-ignore
          statusEl.className = 'status success';
          // @ts-ignore
          statusEl.innerHTML = '<p>✅ Servidor TinaCMS activo</p>';
          // @ts-ignore
          contentEl.innerHTML = `
            <p>El servidor GraphQL de TinaCMS está respondiendo correctamente.</p>
            <a href="${TINA_URL}/tina/" class="btn" target="_blank">Abrir Panel TinaCMS</a>
            <p style="margin-top: 16px; font-size: 14px; color: #666;">
              También puedes acceder directamente a: <a href="${TINA_URL}/tina/" target="_blank">${TINA_URL}/tina/</a>
            </p>
          `;
        } else {
          throw new Error('Server responded with error');
        }
      } catch (error) {
  // @ts-ignore
  statusEl.className = 'status error';
  // @ts-ignore
  statusEl.innerHTML = '<p>❌ No se puede conectar al servidor TinaCMS</p>';
  // @ts-ignore
  contentEl.innerHTML = `
          <p>Asegúrate de que el servidor de desarrollo esté corriendo:</p>
          <pre style="background: #f5f5f5; padding: 12px; border-radius: 6px; text-align: left;">pnpm tinacms:dev</pre>
          <p style="margin-top: 16px;">
            <button class="btn" onclick="location.reload()">Reintentar</button>
          </p>
        `;
      }
    }
    checkTinaServer();
  </script>
</body>
</html>
