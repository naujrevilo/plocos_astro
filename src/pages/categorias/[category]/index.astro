---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import { defaultLocale, getTranslations, type Locale } from '../../../lib/i18n';
import { createLocaleHref } from '../../../lib/routes';

import { labelToSlug } from '../../../lib/taxonomy';

export const prerender = true;

export async function getStaticPaths() {
  const categories = await getCollection('categories');
  return categories.map((category) => ({
    params: { category: category.slug },
  }));
}

const { category } = Astro.params;
const currentCategory = await getEntry('categories', category);

if (!currentCategory) {
  throw new Error(`Categoría no encontrada: ${category}`);
}



const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const posts = (await getCollection('blog')).filter(
  (post) => post.data.category && post.data.category.slug === category && post.data.language === locale
);
const translations = getTranslations(locale);
const categoriesCopy = translations.categories;
const fallbackPrefix = categoriesCopy.fallbackDescriptionPrefix;
const categoryTitle = currentCategory.data.title;
const categoryDescription = currentCategory.data.description;
const description = categoryDescription ?? `${fallbackPrefix} ${categoryTitle}.`;
const { Content } = await currentCategory.render();
const englishBodyHtml = currentCategory.data.body_en ?? null;
const shouldRenderHtml = locale === 'en' && Boolean(englishBodyHtml);
const pageTitle = `${categoryTitle} · ${categoriesCopy.title}`;
const backHref = createLocaleHref(locale, translations.paths.categories);
const badge = categoriesCopy.badge;
const emptyMessage = categoriesCopy.empty;
const countStrings = categoriesCopy.count;
---
<BaseLayout title={pageTitle} description={description}>
  <section class="mx-auto max-w-5xl px-4 py-16">
    <div class="space-y-4 pb-10">
      <a href={backHref} class="inline-flex items-center gap-2 text-sm text-text-accent transition hover:text-accent">
        {categoriesCopy.backLink}
      </a>
      {shouldRenderHtml ? (
          <div class="prose" set:html={englishBodyHtml}></div>
        ) : (
          <div class="prose">
            <Content />
          </div>
        )}
        <p class="text-sm uppercase tracking-[0.3em] text-text-secondary opacity-70">{badge}</p>
        <h1 class="text-4xl font-bold tracking-tight text-text-primary">{categoryTitle}</h1>
        <p class="text-sm text-text-secondary">
          {posts.length === 0
            ? emptyMessage
            : `${posts.length} ${posts.length === 1 ? countStrings.singular : countStrings.plural}`}
        </p>
        
      </div>
    </div>

    {posts.length > 0 && (
      <div class="grid gap-6 md:grid-cols-2">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    )}
  </section>
</BaseLayout>
