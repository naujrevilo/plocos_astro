---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { labelToSlug } from '../../../lib/taxonomy';
import { defaultLocale, getTranslations, type Locale } from '../../../lib/i18n';
import { createLocaleHref } from '../../../lib/routes';

interface Props {
  category: string;
  posts: CollectionEntry<'blog'>[];
}

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  console.log('Posts found in [categoria]:', posts.length);
  const categories = new Set<string>();
  for (const post of posts) {
    const postCategories = Array.isArray(post.data.categories) ? post.data.categories : (post.data.categories ? [post.data.categories] : []);
    for (const category of postCategories) {
      categories.add(category);
    }
  }

  return Array.from(categories).map((category) => {
        const filteredPosts = posts.filter((post) => {
      const postCategories = Array.isArray(post.data.categories) ? post.data.categories : (post.data.categories ? [post.data.categories] : []);
      return postCategories.includes(category);
    });
    return {
      params: { categoria: labelToSlug(category) },
      props: {
        category,
        posts: filteredPosts,
      },
    };
  });
}

const { category, posts } = Astro.props as Props;
const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const translations = getTranslations(locale);
const copy = translations.categoriesDetail;
const pageTitle = `${category} · Plocos`;
const description = `${copy.descriptionPrefix} ${category}.`;
const backHref = createLocaleHref(locale, translations.paths.categories);
const postsForLocale = posts.filter((post) => post.data.language === locale);
---
<BaseLayout title={pageTitle} description={description}>
  <section class="mx-auto max-w-5xl px-4 py-16">
    <div class="space-y-4 pb-8">
      <a href={backHref} class="inline-flex items-center gap-2 text-sm text-text-accent transition hover:text-accent">
        {copy.backLink}
      </a>
      <div class="space-y-2">
        <p class="text-sm uppercase tracking-[0.3em] text-text-secondary opacity-70">{copy.badge}</p>
        <h1 class="text-4xl font-bold tracking-tight text-text-primary">{category}</h1>
        <p class="text-sm text-text-secondary">
          {postsForLocale.length} {postsForLocale.length === 1 ? copy.count.singular : copy.count.plural}
        </p>
      </div>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {postsForLocale.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>
</BaseLayout>