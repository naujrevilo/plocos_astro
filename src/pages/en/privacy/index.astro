---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { defaultLocale, getTranslations, type Locale } from '../../../lib/i18n';
import { createLocaleHref } from '../../../lib/routes';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const translations = getTranslations(locale);
const privacy = translations.privacy;
const contactHref = createLocaleHref(locale, translations.paths.contact);
const toSectionId = (value: string) =>
  value
    .toLowerCase()
    .normalize('NFKD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
---
<BaseLayout title={privacy.metaTitle} description={privacy.metaDescription}>
  <article class="mx-auto max-w-3xl space-y-10 px-4 py-16 text-text-secondary">
    <header class="space-y-4">
      <h1 class="text-4xl font-bold tracking-tight text-text-primary md:text-5xl">{privacy.title}</h1>
      <p class="text-xs font-semibold uppercase tracking-[0.35em] text-text-secondary opacity-80">
        {translations.terms.updatedLabel}: {translations.terms.updatedValue}
      </p>
    </header>

    <div class="space-y-6">
      {privacy.sections.map((item) => (
        <section class="space-y-3" aria-labelledby={`privacy-${toSectionId(item.heading)}`}>
          <h2 id={`privacy-${toSectionId(item.heading)}`} class="text-xl font-semibold text-text-primary">
            {item.heading}
          </h2>
          <p class="leading-relaxed">{item.body}</p>
          {item.bullets && item.bullets.length > 0 && (
            <ul class="list-disc space-y-2 pl-6 text-sm leading-relaxed text-text-secondary/90 sm:text-base">
              {item.bullets.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          )}
        </section>
      ))}
    </div>

    {privacy.retention.length > 0 && (
      <section class="space-y-3" aria-labelledby="privacy-retention">
        <h2 id="privacy-retention" class="text-xl font-semibold text-text-primary">Retention periods</h2>
        <div class="overflow-x-auto">
          <table class="w-full border-collapse text-left text-sm sm:text-base">
            <thead>
              <tr class="border-b border-border-subtle">
                <th class="py-2 pr-4 font-semibold text-text-primary">Category</th>
                <th class="py-2 pr-4 font-semibold text-text-primary">Period</th>
              </tr>
            </thead>
            <tbody>
              {privacy.retention.map((row) => (
                <tr class="border-b border-border-subtle/60 align-top">
                  <td class="py-3 pr-4 font-semibold text-text-primary">{row.category}</td>
                  <td class="py-3 pr-4 leading-relaxed">{row.period}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {privacy.arcoProcedure.length > 0 && (
      <section class="space-y-3" aria-labelledby="privacy-arco-procedure">
        <h2 id="privacy-arco-procedure" class="text-xl font-semibold text-text-primary">Procedure to exercise ARCO rights</h2>
        <ol class="list-decimal space-y-2 pl-6 text-sm leading-relaxed text-text-secondary/90 sm:text-base">
          {privacy.arcoProcedure.map((step) => (
            <li>{step}</li>
          ))}
        </ol>
      </section>
    )}

    <section class="space-y-3 rounded-3xl border border-border-subtle bg-surface-elevated px-6 py-6 shadow-contemplation">
      <h2 class="text-xl font-semibold text-text-primary">Contact and response timelines</h2>
      <p class="text-sm leading-relaxed">
        For any request related to this policy, write to
        <a href={`mailto:${privacy.contactEmail}`} class="ml-1 underline decoration-dotted underline-offset-4 hover:text-accent">{privacy.contactEmail}</a>.
        We reply to {privacy.responseTimelines.consultas} and {privacy.responseTimelines.reclamos}.
      </p>
      <a
        href={contactHref}
        class="mt-4 inline-flex items-center justify-center rounded-full border border-border-subtle bg-surface-muted px-5 py-2 text-sm font-semibold uppercase tracking-widest text-text-secondary transition hover:border-accent hover:text-text-primary"
      >
        Contact us
      </a>
    </section>
  </article>
</BaseLayout>