---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { defaultLocale, getTranslations, type Locale } from '../../../lib/i18n';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const translations = getTranslations(locale);
const contact = translations.contact;
const contactEmail = translations.footer.contactEmail;
const archiveLabel = contact.originalArchiveLabel;
const emailLabel = contact.emailLabel;
---
<BaseLayout title={contact.metaTitle} description={contact.metaDescription}>
  <section class="mx-auto max-w-3xl space-y-6 px-4 py-16 text-text-secondary">
    <h1 class="text-4xl font-bold tracking-tight text-text-primary">{contact.title}</h1>
    <p>
      {contact.intro}
    </p>
    <div class="rounded-3xl border border-border-subtle bg-surface-elevated px-6 py-5">
      <h2 class="text-lg font-semibold text-text-primary">{contact.channelsHeading}</h2>
      <ul class="mt-3 space-y-3 text-sm">
        <li>
          <span class="font-semibold text-text-primary">{emailLabel}:</span>
          <a class="ml-2 text-text-accent underline decoration-transparent transition hover:decoration-accent" href={`mailto:${contactEmail}`}>
            {contactEmail}
          </a>
        </li>
        <li>
          <span class="font-semibold text-text-primary">{archiveLabel}:</span>
          <a class="ml-2 text-text-accent underline decoration-transparent transition hover:decoration-accent" href="https://www.plocos.com" target="_blank" rel="noopener noreferrer">
            www.plocos.com
          </a>
        </li>
      </ul>
    </div>
    <p class="text-sm opacity-80">
      {contact.note}
    </p>
  </section>
</BaseLayout>
