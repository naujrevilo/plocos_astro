---
/**
 * /en/contact — Sec Contacto (EN mirror)
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { defaultLocale, getTranslations, type Locale } from '../../../lib/i18n';
import { createLocaleHref } from '../../../lib/routes';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const translations = getTranslations(locale);
const isES = locale === 'es';
const privacyHref = createLocaleHref(locale, translations.paths.privacy);
---
<BaseLayout
  title={isES ? 'Contacto · Plocos' : 'Contact · Plocos'}
  description={isES
    ? 'Canal formal para peticiones ARCO (derechos de Acceso, Rectificación, Cancelación y Oposición) y consultas generales sobre la plataforma.'
    : 'Formal channel for ARCO requests (Access, Rectification, Cancellation, Opposition) and general inquiries about the platform.'}
>
  <article class="mx-auto max-w-3xl space-y-12 px-4 py-16 text-text-secondary">
    <header class="space-y-4">
      <p class="text-xs font-semibold uppercase tracking-[0.35em] text-accent">
        {isES ? 'Sección 5 · Atención al cliente' : 'Section 5 · Customer support'}
      </p>
      <h1 class="text-4xl font-bold tracking-tight text-text-primary md:text-5xl">
        {isES ? 'Contacto' : 'Contact'}
      </h1>
      <p class="text-lg leading-relaxed text-text-secondary/90 max-w-2xl">
        {isES
          ? 'Un canal formal destinado a la recepción de peticiones legales (ejercicio de derechos ARCO sobre datos personales) y consultas generales, cerrando el bucle de atención al cliente.'
          : 'A formal channel for receiving legal requests (ARCO rights over personal data) and general inquiries, closing the customer service loop.'}
      </p>
    </header>

    <section class="rounded-3xl border-2 border-accent bg-accent/5 p-8 space-y-4">
      <h2 class="text-xl font-semibold text-text-primary">
        {isES ? 'Peticiones ARCO (Ley 1581/2012)' : 'ARCO requests (Ley 1581/2012)'}
      </h2>
      <p class="leading-relaxed">
        {isES
          ? 'Conforme a la Ley 1581/2012, todo titular puede ejercer en cualquier momento los derechos de Acceso, Rectificación, Cancelación y Oposición (derechos ARCO), y los derechos adicionales de supresión y portabilidad. La cancelación de la cuenta se ejecuta en cascada: se eliminan la fila en `users`, las suscripciones, las anotaciones del Repositorio y, en la siguiente iteración, los perfiles públicos asociados.'
          : 'Under Ley 1581/2012, every data subject may exercise at any time the rights of Access, Rectification, Cancellation, and Opposition (ARCO rights), and the additional rights of erasure and portability. Account cancellation is executed in cascade: the `users` row, subscriptions, Repository annotations, and (in the next iteration) associated public profiles are erased.'}
      </p>
      <p class="text-sm leading-relaxed">
        {isES
          ? 'Para hacerlo, basta con seleccionar la opción "Ejercicio de derechos ARCO" en el formulario de abajo, completar los campos requeridos y adjuntar copia del documento de identidad. Recibirás respuesta en los plazos previstos por la Superintendencia de Industria y Comercio (SIC).'
          : 'To do so, simply select the "Exercise of ARCO rights" option in the form below, complete the required fields, and attach a copy of your ID. You will receive a response within the timeframes provided by the Superintendencia de Industria y Comercio (SIC).'}
      </p>
      <p class="text-xs text-text-secondary/80">
        {isES
          ? '> Ver la Política de Privacidad completa para los procedimientos y plazos exactos.'
          : '> See the full Privacy Policy for the exact procedures and timeframes.'}
        <a href={privacyHref} class="text-accent hover:underline ml-1">
          {isES ? 'Política de Privacidad' : 'Privacy Policy'}
        </a>
      </p>
    </section>

    <section class="rounded-3xl border border-border-subtle bg-surface-elevated p-8 space-y-4">
      <h2 class="text-xl font-semibold text-text-primary">
        {isES ? 'Formulario de contacto' : 'Contact form'}
      </h2>
      <form
        name="contact"
        method="POST"
        action="/en/contact?gracias=1"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="space-y-4"
      >
        <p class="hidden">
          <label>Do not fill: <input name="bot-field" /></label>
        </p>

        <div class="space-y-2">
          <label for="asunto-en" class="block text-sm font-semibold text-text-primary">
            {isES ? 'Tipo de solicitud' : 'Request type'}
            <span class="text-accent">*</span>
          </label>
          <select
            id="asunto-en"
            name="asunto"
            required
            class="block w-full rounded-2xl border border-border-subtle bg-surface-base px-4 py-3 text-base text-text-primary focus:border-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          >
            <option value="consulta-general">
              {isES ? 'Consulta general' : 'General inquiry'}
            </option>
            <option value="arco">
              {isES ? 'Ejercicio de derechos ARCO' : 'Exercise of ARCO rights'}
            </option>
            <option value="suscripcion">
              {isES ? 'Ayuda con mi suscripción' : 'Help with my subscription'}
            </option>
            <option value="repositorio">
              {isES ? 'Aporte al Repositorio' : 'Contribution to the Repository'}
            </option>
            <option value="otro">
              {isES ? 'Otro' : 'Other'}
            </option>
          </select>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-2">
            <label for="nombre-en" class="block text-sm font-semibold text-text-primary">
              {isES ? 'Nombre completo' : 'Full name'}
              <span class="text-accent">*</span>
            </label>
            <input
              id="nombre-en"
              name="nombre"
              type="text"
              required
              autocomplete="name"
              class="block w-full rounded-2xl border border-border-subtle bg-surface-base px-4 py-3 text-base text-text-primary focus:border-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            />
          </div>
          <div class="space-y-2">
            <label for="identificacion-en" class="block text-sm font-semibold text-text-primary">
              {isES ? 'Número de identificación' : 'Identification number'}
            </label>
            <input
              id="identificacion-en"
              name="identificacion"
              type="text"
              autocomplete="off"
              class="block w-full rounded-2xl border border-border-subtle bg-surface-base px-4 py-3 text-base text-text-primary focus:border-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            />
          </div>
        </div>

        <div class="space-y-2">
          <label for="email-en" class="block text-sm font-semibold text-text-primary">
            {isES ? 'Correo electrónico' : 'Email'}
            <span class="text-accent">*</span>
          </label>
          <input
            id="email-en"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="block w-full rounded-2xl border border-border-subtle bg-surface-base px-4 py-3 text-base text-text-primary focus:border-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          />
        </div>

        <div class="space-y-2">
          <label for="mensaje-en" class="block text-sm font-semibold text-text-primary">
            {isES ? 'Mensaje' : 'Message'}
            <span class="text-accent">*</span>
          </label>
          <textarea
            id="mensaje-en"
            name="mensaje"
            required
            rows="6"
            class="block w-full rounded-2xl border border-border-subtle bg-surface-base px-4 py-3 text-base text-text-primary focus:border-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          ></textarea>
        </div>

        <div class="space-y-2">
          <label class="flex items-start gap-3 text-sm leading-relaxed">
            <input
              type="checkbox"
              name="acepta-terminos"
              required
              class="mt-1 h-4 w-4 rounded border-border-subtle text-accent focus:ring-accent"
            />
            <span>
              {isES
                ? 'Acepto el tratamiento de mis datos personales conforme a la Ley 1581/2012 y los Términos del Sitio de Plocos.'
                : 'I accept the processing of my personal data under Ley 1581/2012 and the Plocos Site Terms.'}
            </span>
          </label>
        </div>

        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-full bg-accent px-6 py-3 text-sm font-semibold uppercase tracking-widest text-surface-base shadow-md transition hover:bg-text-primary hover:text-surface-base"
        >
          {isES ? 'Enviar' : 'Submit'}
        </button>
      </form>
    </section>

    <p class="text-sm text-text-secondary/70 text-center">
      {isES
        ? '¿Prefieres correo directo? Escríbenos a '
        : 'Prefer direct email? Write to '}
      <a href="mailto:expresatura@plocos.com" class="text-accent hover:underline">
        expresatura@plocos.com
      </a>
    </p>
  </article>
</BaseLayout>
