export const prerender = false;
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Comments as CommentsTable, db, desc, or, isNull, eq } from 'astro:db';
import { createLocaleHref } from '../../lib/routes';
import { getTranslations, type Locale } from '../../lib/i18n';


const COOKIE_NAME = 'plocos-comments-token';
const requestUrl = new URL(Astro.request.url);
const moderationToken = import.meta.env.COMMENTS_MODERATION_TOKEN ?? '';
const providedToken = requestUrl.searchParams.get('token');
const cookieToken = Astro.cookies.get(COOKIE_NAME)?.value ?? null;
const isConfigured = moderationToken.length > 0;

let authorized = false;

if (isConfigured) {
  authorized = cookieToken === moderationToken;
  if (providedToken && providedToken === moderationToken) {
    Astro.cookies.set(COOKIE_NAME, moderationToken, {
      path: '/',
      httpOnly: true,
      sameSite: 'strict',
      secure: import.meta.env.PROD, // La cookie debe ser segura en producción (HTTPS)
      maxAge: 60 * 60 * 24 * 30,
    });
    // Redirige inmediatamente para eliminar el token de la URL
    requestUrl.searchParams.delete('token');
    return Astro.redirect('/admin/comments');
  }
}

const invalidToken = Boolean(providedToken && isConfigured && providedToken !== moderationToken);

interface CommentRow {
  id: number;
  name: string | null;
  email: string | null;
  message: string;
  slug: string;
  locale: string;
  createdAt: Date;
  viewPath: string;
  formattedDate: string;
}

function mapRow(row: {
  id: number;
  name: string | null;
  email: string | null;
  message: string;
  slug: string;
  locale: string;
  createdAt: Date | string;
}): CommentRow {
  const locale = row.locale as Locale;
  const translations = getTranslations(locale);
  const path = createLocaleHref(locale, `${translations.paths.posts}/${row.slug}`);
  const createdAt = row.createdAt instanceof Date ? row.createdAt : new Date(row.createdAt);
  const formatter = new Intl.DateTimeFormat(locale, { dateStyle: 'medium', timeStyle: 'short' });

  return {
    id: row.id,
    name: row.name,
    email: row.email,
    message: row.message,
    slug: row.slug,
    locale,
    createdAt,
    viewPath: `${path}#comments`,
    formattedDate: formatter.format(createdAt),
  };
}

const pendingCommentsData = authorized
  ? await db
      .select({
        id: CommentsTable.id,
        name: CommentsTable.name,
        email: CommentsTable.email,
        message: CommentsTable.message,
        slug: CommentsTable.postSlug,
        locale: CommentsTable.locale,
        createdAt: CommentsTable.createdAt,
      })
      .from(CommentsTable)
      .where(or(eq(CommentsTable.approved, 0), isNull(CommentsTable.approved)))
      .orderBy(desc(CommentsTable.createdAt))
  : [];
const pendingComments = pendingCommentsData.map(mapRow);

const approvedCommentsData = authorized
  ? await db
      .select({
        id: CommentsTable.id,
        name: CommentsTable.name,
        email: CommentsTable.email,
        message: CommentsTable.message,
        slug: CommentsTable.postSlug,
        locale: CommentsTable.locale,
        createdAt: CommentsTable.createdAt,
      })
      .from(CommentsTable)
      .where(eq(CommentsTable.approved, 1))
      .orderBy(desc(CommentsTable.createdAt))
      .limit(15)
  : [];
const approvedComments = approvedCommentsData.map(mapRow);
---
<BaseLayout title="Moderación de comentarios · Plocos" description="Panel interno para revisar y moderar comentarios del archivo.">
  <section class="mx-auto max-w-5xl px-4 py-16">
    <header class="mb-10 space-y-3">
      <h1 class="text-3xl font-semibold text-text-primary">Moderación de comentarios</h1>
      <p class="text-sm text-text-secondary">
        Gestiona las contribuciones hechas desde el formulario público. Usa los botones para aprobar o eliminar.
      </p>
      {!isConfigured && (
        <p class="rounded-lg border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-600">
          Debes definir <code>COMMENTS_MODERATION_TOKEN</code> en el entorno para habilitar este panel.
        </p>
      )}
      {invalidToken && (
        <p class="rounded-lg border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-600">
          Token inválido. Verifica la URL o solicita uno nuevo al equipo técnico.
        </p>
      )}
      {isConfigured && !authorized && !invalidToken && (
        <form class="mt-4 flex max-w-md items-center gap-3" method="get">
          <label class="sr-only" for="token-input">Token de moderación</label>
          <input
            id="token-input"
            name="token"
            type="password"
            placeholder="Introduce tu token"
            class="flex-1 rounded-lg border border-border-subtle bg-surface px-3 py-2 text-sm text-text-primary outline-none focus:border-accent focus:ring-2 focus:ring-accent/30"
          />
          <button
            type="submit"
            class="rounded-lg bg-accent px-4 py-2 text-sm font-semibold uppercase tracking-[0.2em] text-surface transition hover:bg-accent-strong"
          >
            Acceder
          </button>
        </form>
      )}
    </header>

    {authorized ? (
      <>
        <div class="mb-8 rounded-xl border border-border-subtle bg-surface-muted p-4 text-sm text-text-secondary">
          <p>
            Navega a la publicación para revisar el contexto antes de aprobar. Las acciones se guardan de inmediato en Turso.
          </p>
        </div>

        <div class="space-y-10" data-comments-dashboard>
          <div>
            <h2 class="text-lg font-semibold text-text-primary">
              Pendientes de moderación (<span data-pending-count>{pendingComments.length}</span>)
            </h2>
            <div class="mt-4 space-y-6" data-pending-list>
              {pendingComments.length === 0 && (
                <p class="rounded-lg border border-border-subtle bg-surface-muted px-4 py-5 text-sm text-text-secondary">
                  No hay comentarios pendientes. ¡Buen trabajo!
                </p>
              )}
              {pendingComments.map((comment) => (
                <div
                  class="rounded-lg border border-border-secondary bg-surface p-4"
                  data-comment-card
                  data-id={comment.id}
                >
                  <div class="flex items-center justify-between text-xs text-text-secondary/80">
                    <div class="flex items-center gap-2">
                      <span class="font-semibold text-text-primary">{comment.name}</span>
                      {comment.email && <span class="text-text-secondary">({comment.email})</span>}
                    </div>
                    <time datetime={comment.createdAt.toISOString()}>{comment.formattedDate}</time>
                  </div>
                  <p class="mt-3 whitespace-pre-wrap text-sm leading-relaxed text-text-primary">{comment.message}</p>
                  <div class="mt-4 flex flex-wrap gap-3">
                    <a
                      href={comment.viewPath}
                      target="_blank"
                      class="inline-flex items-center justify-center gap-2 rounded-lg border border-border-subtle bg-surface-muted px-3 py-2 text-xs font-semibold text-text-secondary transition hover:bg-surface-raised"
                      rel="noopener noreferrer"
                    >
                      Ver contexto
                    </a>
                    <button
                      data-action="approve"
                      class="inline-flex items-center justify-center gap-2 rounded-lg bg-green-500/10 px-3 py-2 text-xs font-semibold text-green-600 transition hover:bg-green-500/20"
                    >
                      Aprobar
                    </button>
                    <button
                      data-action="delete"
                      class="inline-flex items-center justify-center gap-2 rounded-lg bg-red-500/10 px-3 py-2 text-xs font-semibold text-red-600 transition hover:bg-red-500/20"
                    >
                      Eliminar
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <div>
            <h2 class="text-lg font-semibold text-text-primary">
              Aprobados recientemente (<span data-approved-count>{approvedComments.length}</span>)
            </h2>
            <div class="mt-4 space-y-6" data-approved-list>
              {approvedComments.length === 0 && (
                <p class="rounded-lg border border-border-subtle bg-surface-muted px-4 py-5 text-sm text-text-secondary">
                  Aún no hay comentarios aprobados.
                </p>
              )}
              {approvedComments.map((comment) => (
                <div
                  class="rounded-lg border border-border-secondary bg-surface p-4"
                  data-comment-card
                  data-id={comment.id}
                >
                  <div class="flex items-center justify-between text-xs text-text-secondary/80">
                    <div class="flex items-center gap-2">
                      <span class="font-semibold text-text-primary">{comment.name}</span>
                      {comment.email && <span class="text-text-secondary">({comment.email})</span>}
                    </div>
                    <time datetime={comment.createdAt.toISOString()}>{comment.formattedDate}</time>
                  </div>
                  <p class="mt-3 whitespace-pre-wrap text-sm leading-relaxed text-text-primary">{comment.message}</p>
                  <div class="mt-4 flex flex-wrap gap-3">
                    <a
                      href={comment.viewPath}
                      target="_blank"
                      class="inline-flex items-center justify-center gap-2 rounded-lg border border-border-subtle bg-surface-muted px-3 py-2 text-xs font-semibold text-text-secondary transition hover:bg-surface-raised"
                      rel="noopener noreferrer"
                    >
                      Ver contexto
                    </a>
                    <button
                      data-action="delete"
                      class="inline-flex items-center justify-center gap-2 rounded-lg bg-red-500/10 px-3 py-2 text-xs font-semibold text-red-600 transition hover:bg-red-500/20"
                    >
                      Eliminar
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
        <p class="mt-12 text-xs uppercase tracking-[0.3em] text-text-secondary" data-feedback></p>
      </>
    ) : (
      <p class="rounded-lg border border-border-subtle bg-surface-muted px-4 py-5 text-sm text-text-secondary">
        Ingresa el token de moderación para continuar. Si no lo tienes, coordina con el equipo técnico.
      </p>
    )}
  </section>
<script>
  const dashboard = document.querySelector('[data-comments-dashboard]');
  if (dashboard) {
    dashboard.addEventListener('click', async (event) => {
      const target = event.target as HTMLElement;
      const actionButton = target.closest('button[data-action]');
      if (!actionButton) return;

      const action = actionButton.getAttribute('data-action');
      const card = target.closest('[data-comment-card]');
      const id = card?.getAttribute('data-id');

      if (!action || !id) return;

      const confirmed = confirm(`¿Estás seguro de que quieres ${action === 'approve' ? 'aprobar' : 'eliminar'} este comentario?`);
      if (!confirmed) return;

      actionButton.setAttribute('disabled', 'true');
      actionButton.textContent = 'Procesando...';

      try {
        const response = await fetch('/api/comments/moderate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, action }),
        });

        if (!response.ok) {
          const { error } = await response.json();
          throw new Error(error || 'La acción de moderación falló.');
        }

        // Solo si la API tiene éxito, actualizamos la UI
        const channel = new BroadcastChannel('comments');
        if (action === 'approve') {
          const approvedList = document.querySelector('[data-approved-list]');
          const clonedCard = card.cloneNode(true) as HTMLElement;
          clonedCard.querySelector('[data-action="approve"]')?.remove();
          
          approvedList?.querySelector('[data-empty-approved]')?.remove();
          approvedList?.prepend(clonedCard);
          
          channel.postMessage('new_comment_approved');
        }
        
        card?.remove();

        // Actualizar contadores
        const pendingCountEl = document.querySelector('[data-pending-count]');
        const approvedCountEl = document.querySelector('[data-approved-count]');
        
        if (pendingCountEl) {
          const currentCount = parseInt(pendingCountEl.textContent || '1');
          const newCount = Math.max(0, currentCount - 1);
          pendingCountEl.textContent = newCount.toString();

          if (newCount === 0) {
            const pendingList = document.querySelector('[data-pending-list]');
            const emptyMessage = document.createElement('p');
            emptyMessage.className = 'rounded-lg border border-border-subtle bg-surface-muted px-4 py-5 text-sm text-text-secondary';
            emptyMessage.textContent = 'No hay comentarios pendientes. ¡Buen trabajo!';
            pendingList?.append(emptyMessage);
          }
        }
        
        if (approvedCountEl && action === 'approve') {
          approvedCountEl.textContent = (parseInt(approvedCountEl.textContent || '0') + 1).toString();
        }

      } catch (error) {
        console.error('Error de moderación:', error);
        alert(`No se pudo completar la acción: ${error.message}`);
        actionButton.removeAttribute('disabled');
        actionButton.textContent = action === 'approve' ? 'Aprobar' : 'Eliminar';
      }
    });
  }
</script>
</BaseLayout>
