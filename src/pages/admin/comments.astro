export const prerender = false;
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Comments as CommentsTable, db, desc, eq } from 'astro:db';
import { createLocaleHref } from '../../lib/routes';
import { getTranslations, type Locale } from '../../lib/i18n';

const COOKIE_NAME = 'plocos-comments-token';
const requestUrl = new URL(Astro.request.url);
const moderationToken = import.meta.env.COMMENTS_MODERATION_TOKEN ?? '';
const providedToken = requestUrl.searchParams.get('token');
const cookieToken = Astro.cookies.get(COOKIE_NAME)?.value ?? null;
const isConfigured = moderationToken.length > 0;

let authorized = false;

if (isConfigured) {
  authorized = cookieToken === moderationToken;
  if (providedToken && providedToken === moderationToken) {
    Astro.cookies.set(COOKIE_NAME, moderationToken, {
      path: '/',
      httpOnly: true,
      sameSite: 'strict',
      secure: false, // Permitir cookie en desarrollo (http)
      maxAge: 60 * 60 * 24 * 30,
    });
    // Redirige inmediatamente para eliminar el token de la URL
    requestUrl.searchParams.delete('token');
    return Astro.redirect(requestUrl.toString());
  }
}

const invalidToken = Boolean(providedToken && isConfigured && providedToken !== moderationToken);

interface CommentRow {
  id: number;
  name: string | null;
  email: string | null;
  message: string;
  slug: string;
  locale: string;
  createdAt: Date;
  viewPath: string;
  formattedDate: string;
}

function mapRow(row: {
  id: number;
  name: string | null;
  email: string | null;
  message: string;
  slug: string;
  locale: string;
  createdAt: Date | string;
}): CommentRow {
  const locale = row.locale as Locale;
  const translations = getTranslations(locale);
  const path = createLocaleHref(locale, `${translations.paths.posts}/${row.slug}`);
  const createdAt = row.createdAt instanceof Date ? row.createdAt : new Date(row.createdAt);
  const formatter = new Intl.DateTimeFormat(locale, { dateStyle: 'medium', timeStyle: 'short' });

  return {
    id: row.id,
    name: row.name,
    email: row.email,
    message: row.message,
    slug: row.slug,
    locale,
    createdAt,
    viewPath: `${path}#comments`,
    formattedDate: formatter.format(createdAt),
  };
}

const pendingComments = authorized
  ? (await db
      .select({
        id: CommentsTable.id,
        name: CommentsTable.name,
        email: CommentsTable.email,
        message: CommentsTable.message,
        slug: CommentsTable.postSlug,
        locale: CommentsTable.locale,
        createdAt: CommentsTable.createdAt,
      })
      .from(CommentsTable)
      .where(eq(CommentsTable.approved, false))
      .orderBy(desc(CommentsTable.createdAt))
    ).map(mapRow)
  : [];

const recentComments = authorized
  ? (await db
      .select({
        id: CommentsTable.id,
        name: CommentsTable.name,
        email: CommentsTable.email,
        message: CommentsTable.message,
        slug: CommentsTable.postSlug,
        locale: CommentsTable.locale,
        createdAt: CommentsTable.createdAt,
        approved: CommentsTable.approved,
      })
      .from(CommentsTable)
      .orderBy(desc(CommentsTable.createdAt))
      .limit(30)
    ).map((row) => ({
      ...mapRow(row),
      approved: row.approved,
    }))
  : [];

const approvedRecent = recentComments.filter((row) => row.approved).slice(0, 15);
const rejectedOrPendingRecent = recentComments.filter((row) => !row.approved).slice(0, 15);
---
<BaseLayout title="Moderación de comentarios · Plocos" description="Panel interno para revisar y moderar comentarios del archivo.">
  <section class="mx-auto max-w-5xl px-4 py-16">
    <header class="mb-10 space-y-3">
      <h1 class="text-3xl font-semibold text-text-primary">Moderación de comentarios</h1>
      <p class="text-sm text-text-secondary">
        Gestiona las contribuciones hechas desde el formulario público. Usa los botones para aprobar o eliminar.
      </p>
      {!isConfigured && (
        <p class="rounded-lg border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-600">
          Debes definir <code>COMMENTS_MODERATION_TOKEN</code> en el entorno para habilitar este panel.
        </p>
      )}
      {invalidToken && (
        <p class="rounded-lg border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-600">
          Token inválido. Verifica la URL o solicita uno nuevo al equipo técnico.
        </p>
      )}
      {isConfigured && !authorized && !invalidToken && (
        <form class="mt-4 flex max-w-md items-center gap-3" method="get">
          <label class="sr-only" for="token-input">Token de moderación</label>
          <input
            id="token-input"
            name="token"
            type="password"
            placeholder="Introduce tu token"
            class="flex-1 rounded-lg border border-border-subtle bg-surface px-3 py-2 text-sm text-text-primary outline-none focus:border-accent focus:ring-2 focus:ring-accent/30"
          />
          <button
            type="submit"
            class="rounded-lg bg-accent px-4 py-2 text-sm font-semibold uppercase tracking-[0.2em] text-surface transition hover:bg-accent-strong"
          >
            Acceder
          </button>
        </form>
      )}
    </header>

    {authorized ? (
      <>
        <div class="mb-8 rounded-xl border border-border-subtle bg-surface-muted p-4 text-sm text-text-secondary">
          <p>
            Navega a la publicación para revisar el contexto antes de aprobar. Las acciones se guardan de inmediato en Turso.
          </p>
        </div>

        <div class="space-y-10" data-comments-dashboard>
          <section>
            <header class="mb-4 flex items-center justify-between">
              <h2 class="text-lg font-semibold text-text-primary">Pendientes de revisión ({pendingComments.length})</h2>
              <span class="text-xs uppercase tracking-[0.3em] text-text-secondary">Solo visibles para el equipo</span>
            </header>
            {pendingComments.length ? (
              <ul class="grid gap-4" data-pending-list>
                {pendingComments.map((comment) => (
                  <li
                    data-comment-card
                    data-id={comment.id}
                    class="rounded-xl border border-border-subtle bg-surface p-5 shadow-contemplation"
                  >
                    <div class="flex flex-wrap items-center justify-between gap-3 text-xs text-text-secondary/80">
                      <div class="space-x-2">
                        <span class="font-semibold text-text-primary">#{comment.id}</span>
                        <span>·</span>
                        <span>{comment.formattedDate}</span>
                        <span>·</span>
                        <span>{comment.locale}</span>
                      </div>
                      <a
                        href={comment.viewPath}
                        class="text-xs font-semibold uppercase tracking-[0.18em] text-accent hover:text-accent-strong"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        Ver publicación
                      </a>
                    </div>
                    <div class="mt-3 space-y-2 text-sm text-text-primary">
                      <p class="font-semibold text-text-secondary/90">
                        {comment.name ?? 'Anonimo'}
                        {comment.email && (
                          <span class="ml-2 text-xs text-text-secondary/70">· {comment.email}</span>
                        )}
                      </p>
                      <pre class="whitespace-pre-wrap break-words rounded-lg bg-surface-muted/60 p-3 text-sm text-text-primary">
{comment.message}
                      </pre>
                    </div>
                    <div class="mt-4 flex flex-wrap gap-3">
                      <button
                        type="button"
                        data-action="approve"
                        class="inline-flex items-center justify-center rounded-full bg-emerald-500 px-5 py-2 text-xs font-semibold uppercase tracking-[0.25em] text-white transition hover:bg-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-500/40"
                      >
                        Aprobar
                      </button>
                      <button
                        type="button"
                        data-action="delete"
                        class="inline-flex items-center justify-center rounded-full bg-red-500 px-5 py-2 text-xs font-semibold uppercase tracking-[0.25em] text-white transition hover:bg-red-600 focus:outline-none focus:ring-2 focus:ring-red-500/40"
                      >
                        Eliminar
                      </button>
                    </div>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="rounded-lg border border-border-subtle bg-surface-muted px-4 py-5 text-sm text-text-secondary">
                No hay comentarios pendientes. Revisa la sección "Actividad reciente" para confirmar los últimos cambios.
              </p>
            )}
          </section>

          <section class="space-y-6">
            <header class="space-y-1">
              <h2 class="text-lg font-semibold text-text-primary">Actividad reciente</h2>
              <p class="text-sm text-text-secondary">Últimas interacciones registradas (aprobadas y pendientes).</p>
            </header>
            <div class="grid gap-6 md:grid-cols-2" data-recent-lists>
              <div class="space-y-3">
                <h3 class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-600/80">Aprobadas</h3>
                {approvedRecent.length ? (
                  <ul class="space-y-3" data-approved-list>
                    {approvedRecent.map((comment) => (
                      <li class="rounded-lg border border-border-subtle bg-surface-muted px-4 py-3 text-xs text-text-secondary">
                        <div class="flex justify-between gap-2">
                          <span class="font-semibold text-text-primary">#{comment.id} · {comment.formattedDate}</span>
                          <a
                            href={comment.viewPath}
                            class="text-[0.65rem] font-semibold uppercase tracking-[0.25em] text-accent hover:text-accent-strong"
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            Ver
                          </a>
                        </div>
                        <p class="mt-2 max-h-24 overflow-hidden text-ellipsis text-text-secondary/90">{comment.message}</p>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="rounded-lg border border-border-subtle bg-surface px-4 py-3 text-xs text-text-secondary">
                    Aún no hay aprobaciones recientes.
                  </p>
                )}
              </div>
              <div class="space-y-3">
                <h3 class="text-xs font-semibold uppercase tracking-[0.3em] text-amber-600/80">Pendientes recientes</h3>
                {rejectedOrPendingRecent.length ? (
                  <ul class="space-y-3">
                    {rejectedOrPendingRecent.map((comment) => (
                      <li class="rounded-lg border border-border-subtle bg-surface px-4 py-3 text-xs text-text-secondary">
                        <div class="flex justify-between gap-2">
                          <span class="font-semibold text-text-primary">#{comment.id} · {comment.formattedDate}</span>
                          <span class="uppercase tracking-[0.25em] text-text-secondary/70">{comment.locale}</span>
                        </div>
                        <p class="mt-2 max-h-24 overflow-hidden text-ellipsis text-text-secondary/90">{comment.message}</p>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="rounded-lg border border-border-subtle bg-surface px-4 py-3 text-xs text-text-secondary">
                    Sin actividad adicional.
                  </p>
                )}
              </div>
            </div>
          </section>
        </div>
        <p class="mt-12 text-xs uppercase tracking-[0.3em] text-text-secondary" data-feedback></p>
      </>
    ) : (
      <p class="rounded-lg border border-border-subtle bg-surface-muted px-4 py-5 text-sm text-text-secondary">
        Ingresa el token de moderación para continuar. Si no lo tienes, coordina con el equipo técnico.
      </p>
    )}
  </section>
</BaseLayout>

{authorized && (
  <script type="module" is:inline>
    const dashboard = document.querySelector('[data-comments-dashboard]');
    const feedback = document.querySelector('[data-feedback]');

    function setFeedback(message, variant) {
      if (!(feedback instanceof HTMLElement)) return;
      feedback.textContent = message;
      feedback.dataset.variant = variant;
    }

    async function moderate(id, action, button) {
      try {
        if (button) {
          button.disabled = true;
        }
        const response = await fetch('/api/comments/moderate', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ id, action }),
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok) {
          setFeedback(payload?.error ?? 'No se pudo completar la acción.', 'error');
          return;
        }
        const card = dashboard?.querySelector(`[data-comment-card][data-id="${id}"]`);
        if (card instanceof HTMLElement) {
          card.remove();
        }
        setFeedback(
          action === 'approve' ? 'Comentario aprobado y listo para mostrarse.' : 'Comentario eliminado de la cola.',
          'success'
        );
      } catch (error) {
        console.error('Failed to moderate comment', error);
        setFeedback('Error inesperado al procesar la acción.', 'error');
      } finally {
        if (button) {
          button.disabled = false;
        }
      }
    }

    dashboard?.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const action = target.dataset.action;
      if (action !== 'approve' && action !== 'delete') return;
      const card = target.closest('[data-comment-card]');
      if (!(card instanceof HTMLElement)) return;
      const id = Number(card.dataset.id);
      if (!Number.isInteger(id)) return;
      const button = target instanceof HTMLButtonElement ? target : null;
      moderate(id, action === 'delete' ? 'delete' : 'approve', button);
    });
  </script>
)}
