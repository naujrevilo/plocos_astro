---
export const prerender = false;
import { createClient } from '@libsql/client';
import Layout from '../../layouts/BaseLayout.astro';

const COOKIE_NAME = 'plocos-comments-token';
const moderationToken = import.meta.env.COMMENTS_MODERATION_TOKEN ?? '';
const cookieToken = Astro.cookies.get(COOKIE_NAME)?.value;
const urlToken = Astro.url.searchParams.get('token');

let allComments = [];
let pendingComments = [];
let approvedComments = [];
let error = null;

try {
  const client = createClient({
    url: import.meta.env.ASTRO_DB_REMOTE_URL,
    authToken: import.meta.env.ASTRO_DB_APP_TOKEN,
  });

  const rs = await client.execute("SELECT * FROM Comments ORDER BY createdAt DESC");
  allComments = rs.rows.map(row => ({
    id: row.id,
    name: row.name,
    message: row.message,
    createdAt: row.createdAt,
    approved: row.approved,
    postSlug: row.postSlug,
  }));

  pendingComments = allComments.filter(comment => comment.approved === 0);
  approvedComments = allComments.filter(comment => comment.approved === 1);

} catch (e) {
  error = e.message;
  console.error(e);
}

// Priority 1: Handle token from URL
if (urlToken) {
  if (urlToken === moderationToken) {
    Astro.cookies.set(COOKIE_NAME, urlToken, {
      path: '/',
      httpOnly: true,
      secure: import.meta.env.PROD,
      maxAge: 60 * 60 * 24 * 30, // 30 days
    });
    return Astro.redirect('/admin/comments');
  }
}

// Priority 2: Check for a valid cookie
if (!moderationToken || cookieToken !== moderationToken) {
  return Astro.redirect(`/admin/login?redirect=/admin/comments`);
}
---

<Layout title="Moderación de Comentarios">
  <main class="container mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold mb-6">Moderación de Comentarios</h1>

    {error && (
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-6" role="alert">
        <strong class="font-bold">Error de Conexión:</strong>
        <span class="block sm:inline">{error}</span>
      </div>
    )}

    <section>
      <h2 class="text-xl font-semibold mb-4">Pendientes ({pendingComments.length})</h2>
      <div class="space-y-4">
        {pendingComments.map(comment => (
          <div class="border p-4 rounded-lg" data-comment-id={comment.id} data-post-slug={comment.postSlug}>
            <p><strong>{comment.name}</strong></p>
            <p class="text-sm text-gray-500 mb-2">{new Date(comment.createdAt).toLocaleString()}</p>
            <p>{comment.message}</p>
            <div class="mt-4 flex gap-2">
              <button class="approve-btn bg-green-500 text-white px-3 py-1 rounded">Aprobar</button>
              <button class="delete-btn bg-red-500 text-white px-3 py-1 rounded">Eliminar</button>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-semibold mb-4">Aprobados ({approvedComments.length})</h2>
      <div class="space-y-4">
        {approvedComments.map(comment => (
          <div class="border p-4 rounded-lg" data-comment-id={comment.id}>
            <p><strong>{comment.name}</strong></p>
            <p class="text-sm text-gray-500 mb-2">{new Date(comment.createdAt).toLocaleString()}</p>
            <p>{comment.message}</p>
             <div class="mt-4 flex gap-2">
              <button class="delete-btn bg-red-500 text-white px-3 py-1 rounded">Eliminar</button>
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>

  <script>
    document.addEventListener('click', async (event) => {
      const target = event.target as HTMLElement;
      const commentElement = target.closest('[data-comment-id]');
      if (!commentElement) return;

      const id = commentElement.getAttribute('data-comment-id');
      let action = '';

      if (target.classList.contains('approve-btn')) {
        action = 'approve';
      } else if (target.classList.contains('delete-btn')) {
        action = 'delete';
      }

      if (!action) return;

      try {
        const response = await fetch('/api/comments/moderate', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ id, action }),
        });

        if (response.ok) {
          const postSlug = commentElement.getAttribute('data-post-slug');
          const channel = new BroadcastChannel(`comments-${postSlug}`);
          channel.postMessage({ type: 'comment-approved' });
          commentElement.remove();
          location.reload();
        } else {
          const data = await response.json();
          alert(`Error: ${data.error || 'Failed to moderate comment'}`);
        }
      } catch (error) {
        console.error('Moderation error:', error);
        alert('An unexpected error occurred.');
      }
    });
  </script>
</Layout>
