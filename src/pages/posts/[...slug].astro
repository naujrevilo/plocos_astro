---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate, getPostLocale } from '../../lib/posts';
import { labelToSlug } from '../../lib/taxonomy';
import { defaultLocale, getTranslations, type Locale } from '../../lib/i18n';
import { createLocaleHref } from '../../lib/routes';
import SocialIcon from '../../components/icons/SocialIcon.astro';
import CommentSection from '../../components/CommentSection.astro';

const { slug } = Astro.params;
if (!slug) {
  return new Response("Not found", { status: 404 });
}

const posts = await getCollection('posts');
const post = posts.find((p) => p.slug === slug);

if (!post) {
  return new Response("Not found", { status: 404 });
}

const { Content } = await post.render();
const data = {
  ...post.data,
  title: post.data.title ?? 'Sin título',
  author: post.data.author ?? 'Michel Saer',
};

const postLocale = getPostLocale(post);
const locale = (Astro.currentLocale ?? defaultLocale) as Locale;

if (locale !== postLocale) {
  return Astro.redirect(
    createLocaleHref(postLocale, `${getTranslations(postLocale).paths.posts}/${post.slug}`)
  );
}

const allLocalePosts = posts
  .filter(p => getPostLocale(p) === locale)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const postIndex = allLocalePosts.findIndex(p => p.id === post.id);
const previousPost = postIndex < allLocalePosts.length - 1 ? allLocalePosts[postIndex + 1] : null;
const nextPost = postIndex > 0 ? allLocalePosts[postIndex - 1] : null;

const translations = getTranslations(locale);
const postCopy = translations.posts;
const navigationCopy = postCopy.navigation;
const shareCopy = postCopy.share;
const initialCommentStatusParam = Astro.url.searchParams.get('comment');
const allowedCommentStatuses = ['pending', 'success', 'error'] as const;
const initialCommentStatus = allowedCommentStatuses.includes(initialCommentStatusParam as (typeof allowedCommentStatuses)[number])
  ? (initialCommentStatusParam as (typeof allowedCommentStatuses)[number])
  : null;
const title = `${data.title} · Plocos`;
const description = data.summary ?? `${postCopy.defaultDescriptionPrefix} ${data.pubDate && typeof data.pubDate === 'object' ? formatDate(data.pubDate, locale) : ''}.`;
const base = Astro.site?.origin ?? '';
const canonicalPath = createLocaleHref(locale, `${translations.paths.posts}/${post?.slug ?? ''}`);
const canonical = base ? new URL(canonicalPath, base).toString() : canonicalPath;
const categories = data.categories ?? [];
const author = post.data.author ?? 'Michel Saer';
const backHref = createLocaleHref(locale);
const labelPath = translations.paths.labels;
const shareUrl = canonical;
const encodedShareUrl = encodeURIComponent(shareUrl);
const encodedShareTitle = encodeURIComponent(data.title);
const emailSubject = encodeURIComponent(`${data.title} · ${author}`);
const emailBody = encodeURIComponent(`${data.summary ?? ''}\n\n${shareUrl}`.trim());
const shareLinks = {
  x: `https://twitter.com/intent/tweet?url=${encodedShareUrl}&text=${encodedShareTitle}`,
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodedShareUrl}`,
  instagram: `https://www.instagram.com/?url=${encodedShareUrl}`,
  email: `mailto:?subject=${emailSubject}&body=${emailBody}`,
};
const shareItems = [
  { id: 'x', href: shareLinks.x, label: shareCopy.x, external: true },
  { id: 'facebook', href: shareLinks.facebook, label: shareCopy.facebook, external: true },
  { id: 'instagram', href: shareLinks.instagram, label: shareCopy.instagram, external: true },
  { id: 'email', href: shareLinks.email, label: shareCopy.email, external: false },
] as const;
const heroImageAlt = data.heroImageAlt?.trim() || `${postCopy.imageAlt} ${data.title}`;
const previousHref = previousPost
  ? createLocaleHref(locale, `${translations.paths.posts}/${previousPost.slug}`)
  : null;
const nextHref = nextPost ? createLocaleHref(locale, `${translations.paths.posts}/${nextPost.slug}`) : null;
---
<BaseLayout title={title} description={description} image={data.heroImage} canonicalUrl={canonical}>
  <article class="mx-auto max-w-3xl px-4 py-16">
    <header class="space-y-6">
      <a href={backHref} class="inline-flex items-center gap-2 text-sm text-text-accent transition hover:text-accent">
        {postCopy.backToHome}
      </a>
      <div class="space-y-4">
        <div class="flex flex-wrap items-center gap-3 text-sm text-text-secondary">
          <p class="uppercase tracking-[0.25em] text-text-secondary opacity-70">{data.pubDate && typeof data.pubDate === 'object' ? formatDate(data.pubDate, locale) : ''}</p>
          <span class="opacity-60">•</span>
          <p class="opacity-80">{author}</p>
        </div>
        <h1 class="text-4xl font-bold tracking-tight text-text-primary md:text-5xl">{data.title ?? 'Sin título'}</h1>
        {data.summary && <p class="text-lg leading-relaxed text-text-secondary">{data.summary}</p>}
        {data.updatedDate && data.pubDate && typeof data.updatedDate === 'object' && typeof data.pubDate === 'object' && data.updatedDate > data.pubDate && (
          <p class="text-xs uppercase tracking-wide text-text-secondary opacity-80">
            {postCopy.updatedPrefix} {formatDate(data.updatedDate, locale)}
          </p>
        )}
        {categories.length > 0 && (
          <ul class="flex flex-wrap gap-2 text-[0.7rem] text-text-secondary">
            {categories.map((category: string) => (
              <li class="rounded-full border border-border-subtle bg-surface-muted px-3 py-1 uppercase tracking-wide">
                {category}
              </li>
            ))}
          </ul>
        )}
        {data.labels && data.labels.length > 0 && (
          <ul class="flex flex-wrap gap-2 text-xs text-text-accent">
            {data.labels.map((label: string) => (
              <li>
                <a
                  href={createLocaleHref(locale, `${labelPath}/${labelToSlug(label)}`)}
                  class="inline-flex items-center gap-2 rounded-full border border-accent-muted bg-accent-soft px-3 py-1 transition hover:border-accent hover:text-text-primary"
                >
                  <span class="h-1.5 w-1.5 rounded-full bg-accent" />
                  {label}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </header>

    {data.heroImage && (
      <figure class="my-10 overflow-hidden rounded-3xl border border-border-subtle bg-surface-muted shadow-contemplation">
        <img src={data.heroImage} alt={heroImageAlt} class="w-full object-cover" />
      </figure>
    )}

    <div class="prose">
      <Content />
    </div>

    <section class="mt-14 space-y-4 border-t border-border-subtle pt-6">
      <h2 class="text-xs font-semibold uppercase tracking-[0.35em] text-text-secondary opacity-80">{shareCopy.heading}</h2>
      <div class="flex flex-wrap gap-3">
        {shareItems.map((item) => (
          <a
            href={item.href}
            class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-border-subtle bg-surface-muted text-text-secondary transition hover:border-accent hover:text-text-primary"
            aria-label={item.label}
            title={item.label}
            {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            <SocialIcon name={item.id} class="h-5 w-5" />
            <span class="sr-only">{item.label}</span>
          </a>
        ))}
      </div>
    </section>

    <CommentSection slug={post?.slug ?? ''} locale={locale} initialStatus={initialCommentStatus} />

    {(previousPost || nextPost) && (
      <nav class="mt-16 space-y-6 border-t border-border-subtle pt-6">
        <h2 class="text-xs font-semibold uppercase tracking-[0.35em] text-text-secondary opacity-80">{navigationCopy.heading}</h2>
        <div class="grid gap-4 md:grid-cols-2">
          {previousPost && previousHref && (
            <a
              href={previousHref}
              class="group flex h-full flex-col rounded-2xl border border-border-subtle bg-surface-muted px-5 py-4 transition hover:border-accent hover:text-text-primary"
            >
              <span class="text-xs font-semibold uppercase tracking-[0.3em] text-text-secondary opacity-70">
                {navigationCopy.previous}
              </span>
              <span class="mt-2 text-base font-semibold leading-snug text-text-primary transition group-hover:text-accent">
                {previousPost.data.title}
              </span>
              <span class="mt-1 text-xs text-text-secondary opacity-80">
                {formatDate(previousPost.data.pubDate, locale)}
              </span>
            </a>
          )}
          {nextPost && nextHref && (
            <a
              href={nextHref}
              class="group flex h-full flex-col rounded-2xl border border-border-subtle bg-surface-muted px-5 py-4 transition hover:border-accent hover:text-text-primary"
            >
              <span class="text-xs font-semibold uppercase tracking-[0.3em] text-text-secondary opacity-70">
                {navigationCopy.next}
              </span>
              <span class="mt-2 text-base font-semibold leading-snug text-text-primary transition group-hover:text-accent">
                {nextPost.data.title}
              </span>
              <span class="mt-1 text-xs text-text-secondary opacity-80">
                {formatDate(nextPost.data.pubDate, locale)}
              </span>
            </a>
          )}
        </div>
      </nav>
    )}

    <footer class="mt-12 space-y-4 border-t border-border-subtle pt-6 text-sm text-text-secondary">
      {data.originalUrl && (
        <p>
          {postCopy.originalLabel}: <a href={data.originalUrl} class="hover:text-accent">{data.originalUrl}</a>
        </p>
      )}
      <p class="text-xs uppercase tracking-widest text-text-secondary/80">{postCopy.footerNote}</p>
    </footer>
  </article>
</BaseLayout>
