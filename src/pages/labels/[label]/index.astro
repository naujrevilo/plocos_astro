---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { labelToSlug } from '../../../lib/taxonomy';
import { defaultLocale, getTranslations, type Locale } from '../../../lib/i18n';
import { createLocaleHref } from '../../../lib/routes';

interface Props {
  label: string;
  posts: CollectionEntry<'blog'>[];
}

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const labelMap = new Map<string, string>();

    posts.forEach((post) => {
    (post.data.labels ?? []).forEach((label: string) => {
      labelMap.set(labelToSlug(label), label);
    });
  });

  return Array.from(labelMap.entries()).map(([slug, label]) => ({
    params: { label: slug },
    props: {
      label,
      posts: posts.filter((post) => (post.data.labels ?? []).includes(label)),
    },
  }));
}

const { label, posts } = Astro.props;
const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const translations = getTranslations(locale);
const copy = translations.labelsDetail;
const pageTitle = `${label} · Plocos`;
const description = `${copy.descriptionPrefix} ${label}.`;
const backHref = createLocaleHref(locale, translations.paths.labels);
const postsForLocale = posts.filter((post) => post.data.language === locale);
---
<BaseLayout title={pageTitle} description={description}>
  <section class="mx-auto max-w-5xl px-4 py-16">
    <div class="space-y-4 pb-8">
      <a href={backHref} class="inline-flex items-center gap-2 text-sm text-text-accent transition hover:text-accent">
        {copy.backLink}
      </a>
      <div class="space-y-2">
        <p class="text-sm uppercase tracking-[0.3em] text-text-secondary opacity-70">{copy.badge}</p>
        <h1 class="text-4xl font-bold tracking-tight text-text-primary">{label}</h1>
        <p class="text-sm text-text-secondary">
          {postsForLocale.length} {postsForLocale.length === 1 ? copy.count.singular : copy.count.plural}
        </p>
      </div>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {postsForLocale.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>
</BaseLayout>
