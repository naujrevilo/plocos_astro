---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { labelToSlug } from '../../lib/taxonomy';
import { defaultLocale, getTranslations, type Locale } from '../../lib/i18n';
import { createLocaleHref } from '../../lib/routes';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;

// 1. Obtener todas las publicaciones de la colección 'blog'
const posts = await getCollection('blog', ({ data }) => {
  // Filtrar borradores y por idioma
  return data.draft === false && data.language === locale;
});

// 2. Agrupar y contar las etiquetas (tags)
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  }
}

// 3. Convertir el mapa a un array y ordenarlo alfabéticamente
const tags = Array.from(tagCounts.entries())
  .map(([tag, count]) => ({ tag, count }))
  .sort((a, b) => a.tag.localeCompare(b.tag));

const translations = getTranslations(locale);
const copy = translations.labelsList;
const labelPath = translations.paths.labels;
---
<BaseLayout title={copy.metaTitle} description={copy.metaDescription}>
  <section class="mx-auto flex max-w-6xl flex-col gap-12 px-4 py-16">
    <div class="max-w-3xl space-y-4">
      <h1 class="text-4xl font-bold tracking-tight text-text-primary">{copy.title}</h1>
      <p class="text-lg leading-relaxed text-text-secondary">
        {copy.description}
      </p>
    </div>

    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {tags.map((item) => (
        <a
          href={createLocaleHref(locale, `${labelPath}/${labelToSlug(item.tag)}`)}
          class="group flex flex-col rounded-2xl border border-border-subtle bg-surface-elevated px-6 py-5 transition hover:border-accent"
        >
          <span class="text-sm uppercase tracking-wider text-text-secondary opacity-70">{copy.badge}</span>
          <h2 class="text-2xl font-semibold text-text-primary group-hover:text-accent">
            {item.tag}
          </h2>
          <p class="mt-3 text-sm text-text-secondary">
            {item.count} {item.count === 1 ? copy.count.singular : copy.count.plural}
          </p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
